<edge source="c775c5495ad99b5320aa72aca09e3b0256c129d316bb287aa28b3dfc9bee241d" target="d2ff42bc1f87239a9900d4bf9a4b752802b3ea8e05858c14b31cb4c5b6d0c900" id="ffc0b0b6850f0148de96c68895cbee305f7f1601a87f53855d9dcc90de6de2c2">
  <data key="d5">known_as</data>
  <data key="d6">0.8</data>
  <data key="d7">d9897c43ab4bc62723c8093ead086d9c7552ff6bafaa8bd5f832a44ce0248b19</data>
  <data key="d8">الكوفية الفلسطينية، تعرف ايضا بالسلك او الحطة.</data>
</edge>
<edge source="c775c5495ad99b5320aa72aca09e3b0256c129d316bb287aa28b3dfc9bee241d" target="232775d96512820d5c31875b58c6c04d1e2fe2139728c24c15cd889577f7a373" id="ca929fb26577f4810b3860f03803c884cae6531836c79a6ec091fd37d636eaef">
  <data key="d5">associated_with</data>
  <data key="d6">0.9</data>
  <data key="d7">d9897c43ab4bc62723c8093ead086d9c7552ff6bafaa8bd5f832a44ce0248b19</data>
  <data key="d8">اعتاد الفلاح ان يضع الكوفية لتجفيف عرقه اثناء حراثة الارض ولوقايته من حر الصيف وبرد الشتاء، ارتبط اسم الكوفية بالكفاح الوطني منذ ثورة 1936 في فلسطين، حيث تلثم الفلاحون الثوار بالكوفية لاخفاء ملامحهم اثناء مقاومة القوات البريطانية في فلسطين</data>
</edge>
<edge source="c775c5495ad99b5320aa72aca09e3b0256c129d316bb287aa28b3dfc9bee241d" target="70f8a9e31404a4838e507c4ffd5125f5239a7edd674b0594957aeb53dd00641c" id="62810757f8d4349b76b4018f1dd4bd19ab4943bac793989891c3ec2531c53ecc">
  <data key="d5">associated_with</data>
  <data key="d6">0.9</data>
  <data key="d7">d9897c43ab4bc62723c8093ead086d9c7552ff6bafaa8bd5f832a44ce0248b19</data>
  <data key="d8">اعتاد الفلاح ان يضع الكوفية لتجفيف عرقه اثناء حراثة الارض ولوقايته من حر الصيف وبرد الشتاء، ارتبط اسم الكوفية بالكفاح الوطني منذ ثورة 1936 في فلسطين، حيث تلثم الفلاحون الثوار بالكوفية لاخفاء ملامحهم اثناء مقاومة القوات البريطانية في فلسطين</data>
</edge>
<edge source="c775c5495ad99b5320aa72aca09e3b0256c129d316bb287aa28b3dfc9bee241d" target="70f8a9e31404a4838e507c4ffd5125f5239a7edd674b0594957aeb53dd00641c" id="94cbafa0e08df1f7f4ee1e7d524cd069b668412cc4140efa17a0c5be5172751f">
  <data key="d5">symbol_of</data>
  <data key="d6">0.9</data>
  <data key="d7">d9897c43ab4bc62723c8093ead086d9c7552ff6bafaa8bd5f832a44ce0248b19</data>
  <data key="d8">منذئذ اقترنت الكوفية عند شعوب العالم باسم فلسطين ونضال شعبها، قوي هذا الاقتران اثناء الانتفاضة الاولي عام 1987***** وصولا" الي الانتفاضة الثانية عام 2000.</data>
</edge>
<edge source="c775c5495ad99b5320aa72aca09e3b0256c129d316bb287aa28b3dfc9bee241d" target="cf1d54d018abddea2b0797976ec212d6836733c354796b25c8ccaf121fe0c7f9" id="df120a5934f017127d19f3ac2d8ccaa773bdfd2ba0c3bd16f47363a064aab81d">
