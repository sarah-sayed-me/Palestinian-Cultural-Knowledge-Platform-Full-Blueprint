  <data key="d6">0.85</data>
  <data key="d7">2e5152b5a65fdd787440d768c91b7a71c79bce2b55f60e4031203e7da67f7b78</data>
  <data key="d8">وحد داوود عليه السلام القبائل، وحولها الي مملكة متحدة عاصمتها القدس ووسع حدود مملكته، وهزم المؤابيين والعمونيين والادوميين.</data>
</edge>
<edge source="a7af4c097cfea6f9fab228957a2f33c878f9c9c4d5eb5cb8e0a8cec69cd84add" target="8f1566a5852caedf343ce8454575a8722c5e26dbab0e916c362a1e8dbe3f91ba" id="255e420570ab6a60ef428487184a8b018284183c4eee97a0ee5679bab277b07f">
  <data key="d5">capital_of</data>
  <data key="d6">0.85</data>
  <data key="d7">2e5152b5a65fdd787440d768c91b7a71c79bce2b55f60e4031203e7da67f7b78</data>
  <data key="d8">وحد داوود عليه السلام القبائل، وحولها الي مملكة متحدة عاصمتها القدس ووسع حدود مملكته، وهزم المؤابيين والعمونيين والادوميين.</data>
</edge>
<edge source="c9a030d7f176b776e582214820330caab0b95162eecaad6e2a5280eac7b3fd1d" target="5cb9ef9dd5649d751b3f90c6824f9d3ec9fd23897cc800fff9b09555f9423d14" id="aaf96c02f880df3189466521e3a7747d7537300b379ad60ab1ea2ee96f006d53">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">4ac1146ef990de8659e494b60537c510f274031cc6e8ea0cbfa21f72d80ea695</data>
  <data key="d8">وافادت مصادر امنية ومحلية، بان جيبات الاحتلال اقتحمت احياء عدة من مدينة نابلس، ومخيمي عسكر الجديد والقديم، ومنطقة البلد شرقا، اضافة الي بلدات تل جنوب غرب نابلس، وحوارة، وعوريف، وكفر قليل جنوب نابلس، وعصيرة الشمالية شمال نابلس، وسالم شرقا، وداهمت عددا كبيرا من المنازل، وفتشتها، وعبثت بمحتوياتها .</data>
</edge>
<edge source="039eaea703bbcaf94e6731d7a2f33820b3c54fcdd16ec109a6770e29a202b49c" target="edb51ec640ebe7152cef6eb1dbee252afd679f3c20916413704a78efaa7fee94" id="66d869057c5d76e0e8b4740202b2d7aece48dafe202e3c7df84f1557c71346fc">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">b441090b96d6c977236edaafedae2175971d18438d44048376ca32dc8ebe692c</data>
  <data key="d8">سلفيت 26-7-2026 وفا اعتقلت قوات الاحتلال الاسرائيلي، فجر اليوم الاحد، مواطنا، وسرقت اموالا ومصاغات ذهبية من بلدة قراوة بني حسان غرب سلفيت.</data>
</edge>
<edge source="b4603ec97fc4d6f24ce68c4e54d79bdc9474e12416ac0561caedde63adfffd10" target="97134d0e6d545233eee67fe6d3f742c4038b4ce9c4b938cbc7c19e786f7d0bed" id="821d7a35621a93a644d496ed2b265a60f596bfff82c11c3d29c179021734a4b0">
  <data key="d5">warned_about</data>
  <data key="d6">0.85</data>
  <data key="d7">56ef7a665d767d239f588fd708f2e466934f4e796c3cb5c15a3a526d0ae8131f</data>
  <data key="d8">وحذر رمضان من التحديات المركبة في مدينة القدس المحتلة، حيث تواصل سلطات الاحتلال التدخل في المناهج التعليمية والتضييق علي المؤسسات الثقافية والمواقع التاريخية والدينية.</data>
</edge>
<edge source="b4603ec97fc4d6f24ce68c4e54d79bdc9474e12416ac0561caedde63adfffd10" target="8f1566a5852caedf343ce8454575a8722c5e26dbab0e916c362a1e8dbe3f91ba" id="dc7426d28a5ec75a8d6c73359d16a745e4eec332681763612a6e32f4938ee8e4">
