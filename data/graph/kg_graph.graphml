  <data key="d7">336759792868896465e42aa9f314214111f6040d79afc098bc43813f421fc153</data>
  <data key="d8">كانت ابل القمح قرية فلسطينية تقع بالقرب من الحدود اللبنانية شمال صفد.</data>
</edge>
