<edge source="e35c2a8a77aea3f2080ad985bee5d53f30b6644d8be8fe8f822f1beb4f99ca6a" target="091310bfcd623c64a78576eb7180eea50beac4048da148b57abfb61027fa1c41" id="01250101ebf3ea7a7d3b305fe3172058dfcf4d7880f21464b784ecb2aef8e404">
  <data key="d5">located_in</data>
  <data key="d6">0.9</data>
  <data key="d7">91c0d63b0ed171a0de9e3a985dcf234c562f6071b1cbc288d62398e2be15db4e</data>
  <data key="d8">اجزم: تقع الي الجنوب من حيفا وتبعد عنها 28 كم، ازالتها سلطات الاحتلال عام 1948م، واقامت علي اراضيها والبالغة مساحتها 46900 دونما مستوطنة (موشاف كيريم مهرال) التي اقيمت عام 1926م، بلغ عدد سكانها عام 1922م حوالي 1610 نسمة ارتفع الي 2160 نسمة عام 1931، والي 2970 نسمة عام 1945م.</data>
</edge>
<edge source="e35c2a8a77aea3f2080ad985bee5d53f30b6644d8be8fe8f822f1beb4f99ca6a" target="8431b54f35bbc978ee8f7c4d1c8ed1cfdee11b2762d8c97564b5605384650a6d" id="8ea0175cc09e237aee392b445f7da180c036a721a8f5a285772fdd6144d23c6c">
