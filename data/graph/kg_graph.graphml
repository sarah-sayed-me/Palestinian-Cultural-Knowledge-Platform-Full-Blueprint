  <data key="d6">0.7</data>
  <data key="d7">75bc98ced5e1d4af8498568a14cf02d39a6655f05a3e477ac73f0ab468c2c993</data>
  <data key="d8">بدوره قال الفنان المسرحي جوان جان لمراسلة سانا: ان اختيار مخيم اليرموك لاقامة ‏الندوة يمنحها رمزية خاصة لكونه منبرا فلسطينيا حيا يعكس صمود المجتمع، مؤكدا ان ‏الثقافة والفن جزء لا يتجزا من حياة الاهالي ومسيرة المقاومة الثقافية‎.</data>
</edge>
<edge source="79f7bd9cd5e2f0de2bcc67bb9166bed67972b78463a811dc2ebcf943dec66ac5" target="0958366bfcfd1f071095a99ef2ce09a6a1ceb6f48dae23791144d8b2a7a52e67" id="fd5ce9d65fea768da8e94856a78ea58547c6411ec7e7ef3c89af284b8d634284">
  <data key="d5">located_in</data>
  <data key="d6">0.85</data>
  <data key="d7">5417a697d8b5f24bab452bb2551b78ba627df74a239d0c5deb401fc2114e6171</data>
  <data key="d8">يحتضن بيت السناري الاثري بحي السيدة زينب بالقاهرة، والتابع لمكتبة الاسكندرية، في الحادية عشرة صباحا، ورشة عمل ومحاضرة للاحتفال باليوم العالمي للبيئة، تتحدث خلالها وتقدمها، د.</data>
</edge>
<edge source="8f11d5b1c60e65f426c52282703fc350c13628ac9f73f8ec0d5f915409e0a864" target="f8c859b4f36d336690db784e8288749a8dc92274523559f8b6962d0fce6b5c66" id="a6053a70cf827774d81296532c906173bc90a5bcc73227b929348cd75a3b47e9">
  <data key="d5">part_of</data>
  <data key="d6">0.7</data>
  <data key="d7">5417a697d8b5f24bab452bb2551b78ba627df74a239d0c5deb401fc2114e6171</data>
  <data key="d8">وفي اجندة الدستور الثقافية اليوم ايضا، يستقبل مسرح سيد دويش- اوبرا اسكندرية، في السابعة مساء، حفلا للواعدين بمركز تنمية المواهب، لفصلي الاوركسترا والايقاع الشرقي.</data>
</edge>
<edge source="1fee9d76c81c9f9c9469c04b1b4a5715d6baa6b8e031166af254d60849690230" target="27a12039940be2c6efa36e367e4c31749e49009a441034e78b434948c2dd058f" id="1513a6235cf875cb7a458ae8ea9078b570e11e62322cde191d48e402ee80a8f5">
