  <data key="d6">0.8</data>
  <data key="d7">4e04a1269231543496a0adea435f6f10ce39704bb99e01c439c933bbb7feaaaf</data>
  <data key="d8">في فرضية اكثر حداثة يقال بان اشباه بشر سخول وقفزة يمثلون اول خروج للبشر المعاصرين من افريقيا قبل حوالي 125,000 سنة، من خلال شبه جزيرة سيناء علي الارجح، وخصائص القوة التي يتميز بها اشباه بشر سخول وقفزة تمثل الخواص العاقلة القديمة عوضا عن خواص النياندرتال.</data>
</edge>
<edge source="c488bc2cb575980d59828ed8fc91496cdd7ba08478fa3fa20e39939efd891b1b" target="6c6a50b70b23ba17763c89d9f6898cf6c998db2fc0e9b010a6197e3c61da4940" id="e82639d5f3040e2736ce34e1ad8943804dbc3a6896f07e41305d7c0224de569e">
