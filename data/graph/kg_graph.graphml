  <data key="d6">0.8</data>
  <data key="d7">d83cb6e1821693d082fd9d3d84fddab5f2ad82beac2d1e97effa3bc70b6423f4</data>
  <data key="d8">واشارت وزارة السياحة والاثار الي مواقع، بينها سبسطية شمالي الضفة الغربية المحتلة، وبرك سليمان جنوب بيت لحم، والحرم الابراهيمي في الخليل.</data>
</edge>
<edge source="092f84ad7953aa7c6a116bef5ca32b61db6edbfe90af1632b608bb65efc7b5f0" target="68bc65dc430bb05c989edcacd4c1be32d389dcc44373eb92276fd5808ca00bd9" id="07e53f00c4684fd36e31a6cd35b9a6009f24ca1905f127f5e915e61f1d106342">
  <data key="d5">published_in</data>
  <data key="d6">0.8</data>
  <data key="d7">caf369304b56af899dd21d9725f3df8759e3f731ef218f35d5d747407f5d1980</data>
  <data key="d8">ابو جلدة هي اول رواية فلسطينية تصدر من غزة قبل عام 1948، تعد رواية تاريخية واجتماعية للكاتب والصحفي الفلسطيني حلمي ابو شعبان، صدرت طبعتها الاولي عام 1934 عن مطبعة الجامعة الاسلامية في مدينة يافا ابان فترة الانتداب البريطاني علي فلسطين.</data>
</edge>
<edge source="092f84ad7953aa7c6a116bef5ca32b61db6edbfe90af1632b608bb65efc7b5f0" target="542c3e76eb961e10d7d3a067b56f590f4755e5b917f3a960f0d97417127ddc12" id="4e1e5e7549428e611a468edc12b75a6576271896c2f429ecbee1f2a0adb94e73">
  <data key="d5">published_in</data>
  <data key="d6">0.8</data>
  <data key="d7">caf369304b56af899dd21d9725f3df8759e3f731ef218f35d5d747407f5d1980</data>
  <data key="d8">ابو جلدة هي اول رواية فلسطينية تصدر من غزة قبل عام 1948، تعد رواية تاريخية واجتماعية للكاتب والصحفي الفلسطيني حلمي ابو شعبان، صدرت طبعتها الاولي عام 1934 عن مطبعة الجامعة الاسلامية في مدينة يافا ابان فترة الانتداب البريطاني علي فلسطين.</data>
</edge>
<edge source="092f84ad7953aa7c6a116bef5ca32b61db6edbfe90af1632b608bb65efc7b5f0" target="b8b21c37f596ec1dd317bba1763275de90fe96a47cbf7d977f81c46f41586b2c" id="56297c206d40c2248b2d5c8c93ba4b938ff5116a82644b14a4dc63829959bd41">
  <data key="d5">written_by</data>
  <data key="d6">0.95</data>
  <data key="d7">caf369304b56af899dd21d9725f3df8759e3f731ef218f35d5d747407f5d1980</data>
  <data key="d8">ابو جلدة هي اول رواية فلسطينية تصدر من غزة قبل عام 1948، تعد رواية تاريخية واجتماعية للكاتب والصحفي الفلسطيني حلمي ابو شعبان، صدرت طبعتها الاولي عام 1934 عن مطبعة الجامعة الاسلامية في مدينة يافا ابان فترة الانتداب البريطاني علي فلسطين.</data>
</edge>
<edge source="cff97fcf1c9f78e9077f74030e4b27a0274d5e31f8ff56554ee7e5a08f502023" target="b87be429d3eab07c8b5b36e99be30a251f30b6921f03e8cdd794191641b0cf85" id="831190faa56fe27b5783c63fcac215822a7e5883914fb078c53c7ae1d3d0629b">
  <data key="d5">spoke_about</data>
  <data key="d6">0.8</data>
  <data key="d7">30fb5877217efcfc87ea9fd8a238daf9316fc788cbfafeb586656434b7450667</data>
  <data key="d8">وجاءت تصريحات سعيد خلال مقابلة اعلامية تناولت فيها تعامل ادارة جامعة كولومبيا مع الاعتصامات والاحتجاجات الطلابية المرتبطة بالحرب في غزة؛</data>
</edge>
<edge source="6c013b02c79e39af9eb527326c3e236da8f92aae1532bed01f7e2dd4712f0612" target="2233d08d9d39ce4e674112780eb527ce4dc7dc9adef1905a3fa53673bf8c13d0" id="a5fa47aa9a1dd026c939b3e591d7bf64364bd14bbdcba34da4d7a68d8b104341">
  <data key="d5">hosted_event</data>
  <data key="d6">0.9</data>
  <data key="d7">5fba38e6bc5b4aaa440d66f7e437f19964c4128c07b731b91ea7bead86c13b7b</data>
  <data key="d8">اذا سطرت مدينة كفر قرع انجازا فنيا استثنائيا، باحتضانها العرض الافتتاحي الاول للعمل التراثي الموسيقي "نغمة اصل"، في حدث وصف بانه باكورة مشروع موسيقي غير مسبوق علي مستوي المجتمع العربي، حمل التراث الفلسطيني الي خشبة المسرح بلغة فنية اسرة افلحت باسعاد الجمهور وجذب تفاعلهم الوقاد، واعاد احياء الذاكرة الجمعية بابهي صورها، كل هذا والحاضرات من كل اقطار المجتمع العربي يرتدين الزي التراثي الفلسطيني بما يتناغم وروح الحدث وتلبية للمبادرة الرائدة والطلائعية الاولي من نوعها التي اطلقها القصر الثقافي والتي لاقت تجاوبا جارفا من الحاضرات القرعاويات والحاضرات بارتداء زيهن التراثي من كافة انحاء مجتمعنا العربي، ليصنعن بذلك لوحة فنية تراثية سيريالية شامخة تليق باحياء يوم الزي التراثي الفلسطيني المطرز.</data>
</edge>
<edge source="42e07f65bed614669e7e74932b96ce91d4ee12ec0718566b6d221bb07b956472" target="90ac82f588f707678a529de39415e6a927b615d0bdb52be3722c9bdb3aa65e8e" id="ef7972a27ae10690d44009acaeb17c8de73f3d9127e0095037502506abe5b5a9">
  <data key="d5">transferred_authority_from</data>
  <data key="d6">0.85</data>
  <data key="d7">d83cb6e1821693d082fd9d3d84fddab5f2ad82beac2d1e97effa3bc70b6423f4</data>
  <data key="d8">وفي يونيو الماضي، اعلن وزير المالية الاسرائيلي اليميني المتطرف بتسلئيل سموتريتش نقل صلاحيات التخطيط والبناء في محيط الحرم الابراهيمي من بلدية الخليل الي الادارة الاسرائيلية.</data>
</edge>
<edge source="b44622bbc707bf58f7d98224210b25d26836d47674acd256ddd2402426e28d35" target="f68e44fa74f8908723a6a1fa9ed4d794a6f2bcf882cad328ecd7c126e33695a2" id="a4d51504781d7c9b28baadd9b3df960ca61119231265d340bebd9c9e54d48971">
  <data key="d5">located_in</data>
  <data key="d6">0.95</data>
  <data key="d7">429b34399463f0d3e3e4cd3192ba830b567116d0b0d2ee427c238175b05464c6</data>
  <data key="d8">مسجد السيد الهاشم: يقع المسجد في حي الدرج شرق مدينة غزة، ويعتقد ان ضريح جد الرسول صلي الله عليه وسلم هاشم بن عبد مناف يوجد فيه، ولهذا ارتبط اسمه باسم غزة فسميت بغزة هاشم، وفي يوم الثلاثاء 7 ديسمبر 2023، تسببت النيران التي اشتعلت في المسجد جراء غارة جوية للاحتلال الاسرائيلي باضرار جسيمة.</data>
</edge>
<edge source="259b90dc2ae292c3df0e942b9e9ffc6d6cf327fea8fbea3470a18dbe9323e23a" target="707eb42265543cb80b9618006caea9034dbb90a462b55d908f345f6d2c4e327b" id="cb2e412e89b22dc4a20f49bde94d6108a838c9eb057c40e0eebb4e971c36a86d">
  <data key="d5">member_of</data>
  <data key="d6">0.8</data>
  <data key="d7">9d7d104254fb27c3cc0b7a798b2e709d3b403608fa23a9ca2396dd5f554cd698</data>
  <data key="d8">Ibn ( "ثارتلا نم هكرتي ام :لجرلا ةكرت" :لاقي ذا ،ثاريلما نود ثارتلا ظفلب اهيف ةكرتلا فيرعت طبتري</data>
</edge>
<edge source="913f21fff207b2add2709cb6c51f8761632eeaf3d81b877e7e27bb7cd2d47300" target="b5f8a1b5651eda33cde9c75cf9b560cef16d59da0345627998b3368dccf8ef95" id="82b17048f53133b7f00ef056b7f8a7521ba5ea66f805e9dc82cf685dd7eb6b46">
  <data key="d5">related_to</data>
  <data key="d6">0.7</data>
  <data key="d7">0fd5aecb34826710483906e41c147c220faaba9153562c2df43b056d89bd3329</data>
  <data key="d8">اهداف سويف / الجارديان - كاتبة، ورئيسة مؤسسة Engaged Events البريطانية المنظمة للمهرجان (22.</data>
</edge>
<edge source="12d8efab739a25b3906da61cba4d438394af350c6b4e932152058599173c9f77" target="97134d0e6d545233eee67fe6d3f742c4038b4ce9c4b938cbc7c19e786f7d0bed" id="a4e79e92e18739d6cc3c2b17c5d110f8d66802f57bbc1a9d0cad16b98e957b9e">
  <data key="d5">related_to</data>
  <data key="d6">0.85</data>
  <data key="d7">07f310e1c4b6fa9806cdf1db76abe8f8e13a5e6d4e649716c42e4bebe71746ab</data>
  <data key="d8">اهتم الايوبيون بالقدس بشكل رئيسي بعد تحريرها من الفرنجة علي يد صلاح الدين الايوبي، حيث شهدت القدس في العهد الايوبي تشييد العديد من المعالم المعمارية، حيث بنوا اسوار المدينة وابراجها التي كانت قد تهدمت، ولا يزال جزء كبير منها موجود الي الان.</data>
</edge>
<edge source="47eed4e00ba6fe2308d2d3816e9962265a1fcdeb2a65e2da2f41af929155299e" target="a86f40d31dbda4d89150167ddd7a683a59c50b8d1ea19e30aa8611968d2795a1" id="024892f54ddd67c14c10bf1e0db6f36d1e13a8054eeeb301f0296c350e1f09d2">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">1f3c81b568302c92ac5a3c341b2d07a6351e88e64b47b47d0fa0f1b245f7cb9c</data>
  <data key="d8">اعلام فلسطيني: اشتباكات بين مقاومين وقوات الاحتلال بمخيم بلاطة شرق نابلس</data>
</edge>
<edge source="2b0682a01b5bf951028c2915a4442a8660b932ba72fb9985dab5f243304e7946" target="ecc0feb1cd0b0d8fc3fb0c66ba5797d3aa185c60fe1095239cf9cb419ea62526" id="ca19a6c86c7a1f7aa7de99bb7e1ccf21df8dffbe42d55ad28435f1e92d2ed1d3">
  <data key="d5">same_as</data>
  <data key="d6">1.0</data>
  <data key="d7">10f72a1e03b624632fdf02724971420328c69883929520feb77870f02a72d583</data>
  <data key="d8">اعلنت وزارة السياحة والاثار الفلسطينية ، اليوم الخميس، عن اعتماد تسجيل 12 موقعا فلسطينيا جديدا علي القائمة التمهيدية للتراث العالمي لدي منظمة الامم المتحدة للتربية والعلم والثقافة (اليونسكو)، بالتعاون مع المندوبية الدائمة لدولة فلسطين لدي اليونسكو، ليرتفع بذلك عدد المواقع الفلسطينية المدرجة علي القائمة التمهيدية الي 23 موقعا وفقا لما نقلته وكالة "وفا".</data>
</edge>
<edge source="2b0682a01b5bf951028c2915a4442a8660b932ba72fb9985dab5f243304e7946" target="70f8a9e31404a4838e507c4ffd5125f5239a7edd674b0594957aeb53dd00641c" id="8a1d7c1be0f01084ebe31d3c136093ec91d5f28cead153c98c3c6c770b6fed4b">
  <data key="d5">collaboration_with</data>
  <data key="d6">0.85</data>
  <data key="d7">10f72a1e03b624632fdf02724971420328c69883929520feb77870f02a72d583</data>
  <data key="d8">اعلنت وزارة السياحة والاثار الفلسطينية ، اليوم الخميس، عن اعتماد تسجيل 12 موقعا فلسطينيا جديدا علي القائمة التمهيدية للتراث العالمي لدي منظمة الامم المتحدة للتربية والعلم والثقافة (اليونسكو)، بالتعاون مع المندوبية الدائمة لدولة فلسطين لدي اليونسكو، ليرتفع بذلك عدد المواقع الفلسطينية المدرجة علي القائمة التمهيدية الي 23 موقعا وفقا لما نقلته وكالة "وفا".</data>
</edge>
<edge source="8cf1e3d20125e4fee350381bc3144d6c8a493dd74abdcc7af65a90ac9c4923df" target="82c83b295c1d6dfad1788cddf147c5caf67951ece3d24b97cf6d5546e99cb41d" id="b7de3abad3ec9e44ea2240ce3a38f1302de8ea302c4a1523bbc26ce194475a7e">
