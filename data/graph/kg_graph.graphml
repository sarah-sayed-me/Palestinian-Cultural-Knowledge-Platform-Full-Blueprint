  <data key="d8">ووفقا لما ذكره بالمر، الذي كتب في القرن التاسع عشر عندما كان اسم القرية ابل، فانه ربما كان مستمدا من الاسم الانجيلي ابل بيت معكة.</data>
</edge>
<edge source="a63a31a1b65e8c086e10d4b7343d76a01bdfa03fde07c68cdc0cb7c1efcc1502" target="c054c9ddafa30f28a02a09671ad8c502216f1139d5e48883be1d9bc6062b1c9c" id="74948597c50efb2ae7715d285d35aca6141ac74acd4dffaa6712bb0ddc0b1501">
  <data key="d5">described</data>
  <data key="d6">0.85</data>
  <data key="d7">2f268412f83354f2d6db1610cb9f9bd0dad164693e9b5c2f97826938ea38c9dc</data>
  <data key="d8">في عام 2010، وصف الصحفي الاسرائيلي موشيه دان الحركة الفلسطينية بانها "ايديولوجية" تنظر الي اسرائيل علي انها دولة استعمارية استيطانية، ولها هدفين مباشرين: اقامة دولة فلسطينية في الاراضي الفلسطينية التي تحددها خطوط هدنة عام 1949، وتنفيذها.</data>
</edge>
<edge source="c6e0bda9305fd3338c56fd9445d417310dc369ba2cc877a700527db6fd7086c0" target="97134d0e6d545233eee67fe6d3f742c4038b4ce9c4b938cbc7c19e786f7d0bed" id="9571d092d12893dd980eff1e7032cbf39c51ce88b95b460218d870060add1391">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">2f268412f83354f2d6db1610cb9f9bd0dad164693e9b5c2f97826938ea38c9dc</data>
  <data key="d8">" في نظرها، ظهر هذا الامر مع اعمال الاسقف واللاهوتي الانجليكاني كينيث كراج، والكاهن الانجليكاني الفلسطيني نعيم عتيق، مدير مركز سبيل لاهوت التحرير المسكوني ومقره القدس.</data>
</edge>
<edge source="c6e0bda9305fd3338c56fd9445d417310dc369ba2cc877a700527db6fd7086c0" target="8f1566a5852caedf343ce8454575a8722c5e26dbab0e916c362a1e8dbe3f91ba" id="33c1f4e93f61453986c7f9801f741184bc8b08546fef96dd97ef46cefd693483">
  <data key="d5">located_in</data>
  <data key="d6">0.85</data>
  <data key="d7">2f268412f83354f2d6db1610cb9f9bd0dad164693e9b5c2f97826938ea38c9dc</data>
  <data key="d8">" في نظرها، ظهر هذا الامر مع اعمال الاسقف واللاهوتي الانجليكاني كينيث كراج، والكاهن الانجليكاني الفلسطيني نعيم عتيق، مدير مركز سبيل لاهوت التحرير المسكوني ومقره القدس.</data>
</edge>
<edge source="d937b5ba66d97b8f03853a00fedf7ce998aa9fdc7bf6ac71ae53ddfdc7f39b96" target="091310bfcd623c64a78576eb7180eea50beac4048da148b57abfb61027fa1c41" id="01c209eeea7f338efda872a7006a534faf1f2650e7a7c76d66c4e7a4280e01ff">
  <data key="d5">located_in</data>
  <data key="d6">0.9</data>
  <data key="d7">91c0d63b0ed171a0de9e3a985dcf234c562f6071b1cbc288d62398e2be15db4e</data>
  <data key="d8">ابو زريق: تقع الي الجنوب الشرقي من مدينة حيفا وتبعد عنها 23كم، ازالتها سلطات الاحتلال عام 1948م، وبلغت مساحتها اراضيها المسلوبة حوالي 6500 دونما، بلغ عدد سكانها عام 1931م حوالي 406 نسمة، ارتفع الي 550 عام 1945م.</data>
</edge>
<edge source="d937b5ba66d97b8f03853a00fedf7ce998aa9fdc7bf6ac71ae53ddfdc7f39b96" target="8431b54f35bbc978ee8f7c4d1c8ed1cfdee11b2762d8c97564b5605384650a6d" id="a6a1b26308a2c22559a10063ddc7ce06322b945dcfec42fa09d8cee7479f5f7f">
  <data key="d5">located_in</data>
  <data key="d6">0.95</data>
  <data key="d7">91c0d63b0ed171a0de9e3a985dcf234c562f6071b1cbc288d62398e2be15db4e</data>
  <data key="d8">ابو زريق: تقع الي الجنوب الشرقي من مدينة حيفا وتبعد عنها 23كم، ازالتها سلطات الاحتلال عام 1948م، وبلغت مساحتها اراضيها المسلوبة حوالي 6500 دونما، بلغ عدد سكانها عام 1931م حوالي 406 نسمة، ارتفع الي 550 عام 1945م.</data>
</edge>
<edge source="4f977c6f7e34b97fbb629271e411dae1e258e9fc9c35170658cdcc68e2145e57" target="c1a2f82e0c898c8f27fc6f0f1f5f93cff866e993597a5a2956012eeabb2f269b" id="8c7026872e571f36db9bb217fa8214d6b81a40cb11b43f272550f9096990e169">
  <data key="d5">located_in</data>
  <data key="d6">0.85</data>
  <data key="d7">4e04a1269231543496a0adea435f6f10ce39704bb99e01c439c933bbb7feaaaf</data>
  <data key="d8">اكتشاف الادوات العصرية المصنوعة من قبل البشر قبل حوالي 150,000 سنة مضت في جبل فايا، الامارات العربية المتحدة، وفي شبه الجزيرة العربية، بامكانها ان تكون من خروج اقدم للبشر المعاصرين من افريقيا.</data>
</edge>
<edge source="152ca8c9ce55cf3b3da45422185e4757148c9d5197d01b0e0ffe678c03abf9d1" target="b5f8a1b5651eda33cde9c75cf9b560cef16d59da0345627998b3368dccf8ef95" id="24348f37b98ebb93824c58201dd46ebd0a18928c8c795447c721ef0f9beda2fe">
  <data key="d5">member_of</data>
  <data key="d6">0.7</data>
  <data key="d7">0fd5aecb34826710483906e41c147c220faaba9153562c2df43b056d89bd3329</data>
  <data key="d8">اهداف سويف / الجارديان - كاتبة، ورئيسة مؤسسة Engaged Events البريطانية المنظمة للمهرجان (22.</data>
</edge>
<edge source="bd9e917e4552cf5acfc944bedde471ed57cadee723a60299a3e8d033a870344f" target="0432ece946a61c8b833130e2b1b34e3044388ac3fa01906d1c4328f484c612df" id="194853bbc128a505aeec1de343e28e0e3fa73ae4923633001ad7a80238b0bf1f">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">0fd5aecb34826710483906e41c147c220faaba9153562c2df43b056d89bd3329</data>
  <data key="d8">كذلك عدد كبير من طلاب جامعات فلسطينية كجامعة بيرزيت وجامعة بيت لحم، حيث تتم هذه الفعاليات في عدة مراكز ثقافية فلسطينية في الضفة الغربية منها المسرح الوطني الفلسطيني - القدس، ومسرح القصبة - رام الله، ودار الندوة - بيت لحم، ومتحف دار الطفل العربي - القدس، ومسرح الحرية - جنين.</data>
</edge>
<edge source="c7e673d53d67dae813907cfafd3638da96c73253be56676fc95ad18d3c38a755" target="b44622bbc707bf58f7d98224210b25d26836d47674acd256ddd2402426e28d35" id="824108a242fefcbc096a15651c59c9e4483b1e48b5d175bcff5f2f65b08ade88">
  <data key="d5">located_in</data>
  <data key="d6">0.85</data>
  <data key="d7">429b34399463f0d3e3e4cd3192ba830b567116d0b0d2ee427c238175b05464c6</data>
  <data key="d8">مسجد السيد الهاشم: يقع المسجد في حي الدرج شرق مدينة غزة، ويعتقد ان ضريح جد الرسول صلي الله عليه وسلم هاشم بن عبد مناف يوجد فيه، ولهذا ارتبط اسمه باسم غزة فسميت بغزة هاشم، وفي يوم الثلاثاء 7 ديسمبر 2023، تسببت النيران التي اشتعلت في المسجد جراء غارة جوية للاحتلال الاسرائيلي باضرار جسيمة.</data>
</edge>
<edge source="c7e673d53d67dae813907cfafd3638da96c73253be56676fc95ad18d3c38a755" target="f68e44fa74f8908723a6a1fa9ed4d794a6f2bcf882cad328ecd7c126e33695a2" id="806efb413d34643021113192a7797a132893e74d3106080ff03ff585be887f1b">
  <data key="d5">located_in</data>
  <data key="d6">0.85</data>
  <data key="d7">429b34399463f0d3e3e4cd3192ba830b567116d0b0d2ee427c238175b05464c6</data>
  <data key="d8">مسجد السيد الهاشم: يقع المسجد في حي الدرج شرق مدينة غزة، ويعتقد ان ضريح جد الرسول صلي الله عليه وسلم هاشم بن عبد مناف يوجد فيه، ولهذا ارتبط اسمه باسم غزة فسميت بغزة هاشم، وفي يوم الثلاثاء 7 ديسمبر 2023، تسببت النيران التي اشتعلت في المسجد جراء غارة جوية للاحتلال الاسرائيلي باضرار جسيمة.</data>
</edge>
<edge source="38a21e478dd9465d3409303b96ef829837c63d9589be41cb7d9f08c70c1fffd0" target="a1628feb70a8035f4a3ff702efe0c239a4e17e14f16d7906e8bb9903f8540425" id="4be956fbab73a9e7f36367c06988a1718d3fc55935b2f1c29d96c07c5d60583b">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">193611244cee3786513df2959efa909eb4f7f93cc0f516c5e6b08a5de7d68b34</data>
  <data key="d8">اكتسب ابو عرب موهبته الشعرية من جده لامه الشيخ علي الاحمد احد وجهاء قرية الشجرة الذي كان يكتب الشعر.</data>
</edge>
<edge source="f7337f525ff4c5fbd8ffcdd1ba15d4ac51895b522361fd1f35a5fcd657386e0e" target="c6c4ba13fd326f6f0f79f878c8412e7e999780182198b58875b8c9109b82bfa0" id="7779bb1017eb4fe5305703d1f9ecc38a161e77aca73aed5bff920b94d82ae6f4">
  <data key="d5">published</data>
  <data key="d6">0.9</data>
  <data key="d7">3df3aafd9d59d66b110b7311895b7bfa8980c3f26d8cde5bd4f96f36fdcb8164</data>
  <data key="d8">صدر حديثا عن دار الثقافة الجديدة للنشر، رواية "الخيمة البيضاء" للكاتبة الفلسطينية ليانة بدر، في طبعة مصرية، حيث كانت صدرت عن دار نوفل هاشيت انطون في بيروت عام 2016.</data>
</edge>
<edge source="1765c502f3d50216003f76f42938ca52a8ecde991669581fe49f09f81ae58871" target="47b50eca5bbb3820c7827254c669c01051cde0b4386d8ed000327124d52b76d1" id="ef1a67e4afe77eac6482970a48ea2e936930f31c97d4516109d5934c921de989">
  <data key="d5">born_in</data>
  <data key="d6">0.8</data>
  <data key="d7">30fb5877217efcfc87ea9fd8a238daf9316fc788cbfafeb586656434b7450667</data>
  <data key="d8">عن نجلاء سعيد وتعد نجلا سعيد كاتبة ومسرحية وممثلة اميركية من اصول فلسطينية، عرفت باعمالها الادبية والمسرحية التي تتناول قضايا الهوية والانتماء والثقافة العربية في الولايات المتحدة، كما انها ابنة المفكر والاكاديمي الفلسطيني البارز ادوارد سعيد، احد ابرز الاصوات الفكرية في دراسة الاستشراق والنقد الثقافي المعاصر.</data>
</edge>
<edge source="1765c502f3d50216003f76f42938ca52a8ecde991669581fe49f09f81ae58871" target="dd76221d4533eb36f63c6b115718e50b2fa8d0077fe6c7bf158a760d854f6a74" id="b9f4cdcf3713040658666553d7b8dbaa9a6c22b592625f3cbda71902c799ffed">
  <data key="d5">child_of</data>
  <data key="d6">0.95</data>
  <data key="d7">30fb5877217efcfc87ea9fd8a238daf9316fc788cbfafeb586656434b7450667</data>
  <data key="d8">عن نجلاء سعيد وتعد نجلا سعيد كاتبة ومسرحية وممثلة اميركية من اصول فلسطينية، عرفت باعمالها الادبية والمسرحية التي تتناول قضايا الهوية والانتماء والثقافة العربية في الولايات المتحدة، كما انها ابنة المفكر والاكاديمي الفلسطيني البارز ادوارد سعيد، احد ابرز الاصوات الفكرية في دراسة الاستشراق والنقد الثقافي المعاصر.</data>
</edge>
<edge source="1765c502f3d50216003f76f42938ca52a8ecde991669581fe49f09f81ae58871" target="b87be429d3eab07c8b5b36e99be30a251f30b6921f03e8cdd794191641b0cf85" id="8648f87fd4be314efa28471322224c3cb7166bf961ff8063f9e7681a909f5b02">
  <data key="d5">mentioned_in</data>
  <data key="d6">0.8</data>
  <data key="d7">30fb5877217efcfc87ea9fd8a238daf9316fc788cbfafeb586656434b7450667</data>
  <data key="d8">اثارت الكاتبة والمسرحية الفلسطينية الاميركية نجلا سعيد جدلا واسعا عقب تصريحات ادلت بها حول الاحتجاجات المؤيدة للفلسطينيين التي شهدتها جامعة كولومبيا الاميركية، ما دفع الي تصاعد ردود الفعل المؤيدة والمعارضة لمواقفها علي منصات التواصل الاجتماعي.</data>
</edge>
<edge source="2233d08d9d39ce4e674112780eb527ce4dc7dc9adef1905a3fa53673bf8c13d0" target="6c013b02c79e39af9eb527326c3e236da8f92aae1532bed01f7e2dd4712f0612" id="b43934c313228e6a66324a1f07347b36ef382855a209ec131160add199c31158">
  <data key="d5">associated_with</data>
  <data key="d6">0.85</data>
  <data key="d7">5fba38e6bc5b4aaa440d66f7e437f19964c4128c07b731b91ea7bead86c13b7b</data>
  <data key="d8">واستهلت الامسية مديرة القصر الثقافي السيدة مها زحالقة مصالحة بكلمة افتتاحية استثنائية نسجت فيها، بلغة ادبية اسرة، العلاقة الوثيقة بين الثوب الفلسطيني المطرز، والصمود، والهوية، وعراقة الاجداد والجذور، مؤكدة ان كل غرزة في هذا الثوب تحمل حكاية وطن، وان التراث ليس ماضيا يروي، بل حاضر يعاش ومستقبل يصان، فشكلت كلماتها مدخلا وجدانيا عميقا مهد لامسية بقيت راسخة في ذاكرة الحاضرين مؤكدة ان التراث هو شباك الروح الذي يطل علي فردوس الجذور والعراقة والاصالة، مستطردة للتاكيد ان البعد الرمزي لاختيار العرض الغنائي "نغمة اصل" في يوم الزي التراثي هو عظيم وتنفرد به كفر قرع لتكون السباقة لهذه المبادرة التي الهبت الجماهير وملات فضاءات القاعة حبا وحماسا وفرحا وتراثا، كما بعثت مديرة القصر الثقافي بتحية لروح فنان التراث الراحل الفنان شفيق كبها والراحل يوسف ابو ليل، الفنان حميد ابو ليل والفنان صالح ابو ليل مؤكدة دور كفر قرع الريادي في ترسيخ التراث والفن العريق.</data>
</edge>
<edge source="a12b684a062d668baf08492dc9e2d74cbd923cfc3a274bbfd63df73606ad449b" target="0958366bfcfd1f071095a99ef2ce09a6a1ceb6f48dae23791144d8b2a7a52e67" id="31a4a4f03e515fa769f3004cd5555692b509eb4285e74da8323d5f17ae4ad35a">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">45dba9cdcd23cccad42d9b28abe173935905572acf43e3330805fd9915634cea</data>
  <data key="d8">تختتم فعاليات الدورة العاشرة لمهرجان العودة للسينما الفلسطينية في السابعة مساء السبت المقبل، بمركز الابداع بساحة دار الاوبرا المصرية، والذي تنظمه جمعية الفيلم برئاسة مدير التصوير السينمائي محمود عبد السميع، للعام الثاني علي التوالي بالقاهرة، بالتعاون مع اتحاد المراة الفلسطينية بالقاهرة، وصندوق التنمية الثقافية التابع لوزارة الثقافة المصرية.</data>
</edge>
<edge source="fd5b604f67729ac984d8539fe4eca3ef6feb86b181f0d8a592b2088ec14cff93" target="2a878970f061bf9d7f702a9fa664c35cbfaa956e8df41699e508bf527f2eb05e" id="e4aac744713f01c8fc92d9cfc143e1be57005562c08a60e67a79c3615202a6c2">
  <data key="d5">worked_in</data>
  <data key="d6">0.8</data>
  <data key="d7">bfc10e8852ab0f1e05864eccd3063710dd5df7ae618d59614db08db5f8317e35</data>
  <data key="d8">وبعد ذلك قدم الاستاذ نسيم الاطرش، حديثا ثريا وملهما، حيث شارك الحضور جانبا من سيرته الشخصية ومسيرته الثقافية في اليونان، متحدثا عن اعماله وترجماته ودوره في مد الجسور بين الثقافة العربية واليونانية.</data>
</edge>
<edge source="ea9a6d68e4a321b2883a8e8b348561f776da9ac25da3d36f1838c95dd097f97d" target="33157952dbfc1c69ec1dc9cb2be4e47c438a6822836f39fc55c4bff42d7cdc91" id="8ddaa6a9ce0800bfca46e49249275f39214907b99ea77be751a1cba9dbe7efc8">
  <data key="d5">located_in</data>
  <data key="d6">0.85</data>
  <data key="d7">a62ed687f1595b3041ff677f3d5a276109b3ee26fae39e5a451066685492cf5e</data>
  <data key="d8">وافادت مصادر امنية لمراسلنا، بان قوات الاحتلال داهمت منزلين يعودان للمواطنين بسام البلبول في بلدة الخضر جنوبا، وجهاد ابو عمشة في عايدة شمالا، وخطت شعارات عنصرية علي جدرانهما، دون ان يبلغ عن اعتقالات.</data>
</edge>
<edge source="0216f2df6aba6640ae046128b935ea10e1de2d4707dd8c3b9978fcfb3171bc25" target="94a337ec8b0b6fbf4df2aa73d7a538b41e676799f2ced8e4227e89aa1fc7efcb" id="20967d39aa2174b2b462533fb9b08ec4f1b00368e03f5126b7cb4b6eeb46d6fe">
  <data key="d5">located_in</data>
  <data key="d6">0.85</data>
  <data key="d7">a62ed687f1595b3041ff677f3d5a276109b3ee26fae39e5a451066685492cf5e</data>
  <data key="d8">وافادت مصادر امنية لمراسلنا، بان قوات الاحتلال داهمت منزلين يعودان للمواطنين بسام البلبول في بلدة الخضر جنوبا، وجهاد ابو عمشة في عايدة شمالا، وخطت شعارات عنصرية علي جدرانهما، دون ان يبلغ عن اعتقالات.</data>
</edge>
<edge source="4231a2eaeb9e62fb7da4fe24d38b8dda506ecb5ff5a37f1b38eb988a7a27a817" target="984f0e11a378f7caa78e4aa4f8f13cca10ee2ef8b708abb88b60533aa0b83423" id="f445d26e6a84e5921f1e77e5a6c6a01837bde07004c67a4f75e27cdcb4cd1ddf">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">a36f40b2fea80a16fc4fbefaa27121fd0df6ea77d5bca026db9e19431b014981</data>
  <data key="d8">من جهته، ادان محافظ نابلس غسان دغلس احراق مسجد الرحمة في بلدة قصرة جنوب نابلس، مؤكدا ان استهداف دور العبادة والمقدسات الدينية يمثل جريمة خطيرة وانتهاكا صارخا لكل القوانين والاعراف الدولية والانسانية .</data>
</edge>
<edge source="0a2911c065a68d70daa9b488972e501a4317b9a3df6521fe044dd776034461b7" target="1ffb16c3289eb9271ea45859e1f0bb7b40d9f7ab455a26f1b0fa3b071453fc7b" id="78118f308fda813104945216a97f56b5785c54f48e94c28ec4488deb4758865d">
  <data key="d5">located_in</data>
  <data key="d6">0.95</data>
  <data key="d7">4ac1146ef990de8659e494b60537c510f274031cc6e8ea0cbfa21f72d80ea695</data>
  <data key="d8">واكدت المصادر ذاتها، ان قوات الاحتلال اعتقلت 12 مواطنا من مناطق مختلفة بالمحافظة، وهم: عدي محمود ابو شحادة، واحمد محمد ابو شحادة، وادم سائد عودة من بلدة حوارة، ومحمود مصطفي عليان من مخيم عسكر الجديد، وسيف السوداني من مخيم عسكر القديم، ومراد ساجد دويكات من مخيم عسكر البلد، واحمد مراد الكاشف من المساكن الشعبية شرق المدينة، وعز الدين صلاح دروزة من عصيرة الشمالية، ونايف موسي مسلم من دوما، وعادل احمد القني من كفر قليل، وصهيب عاكف اشتية من سالم، ويوسف صلاح شحادة من عوريف .</data>
</edge>
<edge source="27ec185a68d65f76d9d3842815359148355b6819455aaa091f8b22b85b847358" target="e4048b411e9f25c8f9f2e5b186ed4f0fd806754ed70e8a71a9d2e7b718f113c6" id="ddc2d21d5f5a8fe730d740515899e86ed52b1a7554c559b012142ac1fda25d2b">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">3f8c9ea346b209a7d600bb57b0b9f45d79ae0e590a3114f476cf1d414a99bc40</data>
  <data key="d8">وافادت مصادر محلية، بان عددا من المستعمرين منعوا المزراعين من رعي مواشيهم في المراعي المحيطة بخيامهم في خربة سمرة بالاغوار الشمالية، واجبروهم علي مغادرتها.</data>
</edge>
<edge source="2197e1db8bd89d1c08afdd0d0f9e492a20afbf17e57c53609ba28daf40c9d9df" target="79a26d157ce56125edb9dcb3e579e6496836cbbd3dd0d94bd45a966921319fba" id="4c2c603432bb58789afce6736a59d67a1d3dbddf7034c364b9a9dc755c1c27d5">
  <data key="d5">sibling_of</data>
  <data key="d6">0.95</data>
  <data key="d7">44873069d0ad50691d73845f9fef17365b11850b8fb94061cb397e42c48e6fdb</data>
  <data key="d8">وافاد مدير نادي الاسير في طوباس كمال بني عودة بان قوات الاحتلال اعتقلت الشاب بلال جمعة احمد بني عودة (37 عاما)، وشقيقته ارحام جمعة احمد بني عودة (48 عاما)، بعد ان داهمت منزلهما وفتشته.</data>
</edge>
<edge source="86f2559b49dc97bd29ddde617c0da7d134a91997a20bd0a03937e203a4d02d11" target="022f347d476fa4a6a1fb0f5568c5c0256420f10423bdc15603b4bab43e6e74bd" id="ebb9efc6b96b2d8396eb11489a4aff3862eaa2f5f952b52822b4ce3eeaf755f7">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">44873069d0ad50691d73845f9fef17365b11850b8fb94061cb397e42c48e6fdb</data>
  <data key="d8">وكانت قوات الاحتلال، قد اقتحمت فجرا بلدتي طمون جنوب طوباس وعقابا شمالها وداهمت عدة منازل.</data>
</edge>
<edge source="6bc7473c284980573e565db7d5f2629fca203164a5677f21794fea754ce927a1" target="2197e1db8bd89d1c08afdd0d0f9e492a20afbf17e57c53609ba28daf40c9d9df" id="27f5e928f0f1579bd42f0e9e4d123303f63ee8b04e5cf5636e12a63a28987745">
  <data key="d5">reported_arrest_of</data>
  <data key="d6">0.85</data>
  <data key="d7">44873069d0ad50691d73845f9fef17365b11850b8fb94061cb397e42c48e6fdb</data>
  <data key="d8">وافاد مدير نادي الاسير في طوباس كمال بني عودة بان قوات الاحتلال اعتقلت الشاب بلال جمعة احمد بني عودة (37 عاما)، وشقيقته ارحام جمعة احمد بني عودة (48 عاما)، بعد ان داهمت منزلهما وفتشته.</data>
</edge>
<edge source="47f7d0521fb7cf8801733147521ff7c9dd0e2d7c3e5f8c21b49d6bd0373cc235" target="a7bc1e1e0dfd110378ee1956e27958450b99eeae69bf484fd9cc52d352c8ad6e" id="68628563761b7100882e3a3e49f39bc456a71f000648ac414a2faf7c00d60a61">
  <data key="d5">located_in</data>
  <data key="d6">0.85</data>
  <data key="d7">a8892d3bcb48bcedf0ccb683dbe42846853d65a9c4526c3b0b419a4b99441ba6</data>
  <data key="d8">وافادت مصادر محلية ل"وفا"، ان قوات الاحتلال اعتقلت المواطنة بتول جمال من منزلها في قرية كفا جنوب طولكرم، والاسير المحرر عبد الفتاح عازم القدومي (57 عاما)، والاسير المحرر عمار مناع (63 عاما)، من مدينة طولكرم.</data>
</edge>
<edge source="47f7d0521fb7cf8801733147521ff7c9dd0e2d7c3e5f8c21b49d6bd0373cc235" target="44254ae2e038f93c570a69413d7f2f110c2950d1309ae4640fb36f273f285a5c" id="b8736371ee8daaa64ef3452cc3b6a186a22fc0c92bf45560a9c807456c8d2732">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">a8892d3bcb48bcedf0ccb683dbe42846853d65a9c4526c3b0b419a4b99441ba6</data>
  <data key="d8">وافادت مصادر محلية ل"وفا"، ان قوات الاحتلال اعتقلت المواطنة بتول جمال من منزلها في قرية كفا جنوب طولكرم، والاسير المحرر عبد الفتاح عازم القدومي (57 عاما)، والاسير المحرر عمار مناع (63 عاما)، من مدينة طولكرم.</data>
</edge>
<edge source="87b29368ff4da01ba0728faace0cee2cbb013de1aa3b10238a4f2d78c6018b25" target="db1d7b8b8eff99b52c0319d10f8fac05543b19541ceb129902cb9cdc078694f2" id="0062b6ba49a2e0dd74810666659a8b97dc7d4e43b7fd19e84ec19e4700191f11">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">a8892d3bcb48bcedf0ccb683dbe42846853d65a9c4526c3b0b419a4b99441ba6</data>
  <data key="d8">واضافت المصادر ان قوات الاحتلال اعتقلت كلا من: الاسري المحررين علاء شاهين من ضاحية ارتاح، وفيصل محمود خليفة (44 عاما)، وحسام عارف (49 عاما)، وعلي ابو الرب، وعادل قاسم، والشاب محمد قاسم، بعد مداهمة منازلهم في ضاحية اكتابا شرق طولكرم .</data>
</edge>
<edge source="a7bc1e1e0dfd110378ee1956e27958450b99eeae69bf484fd9cc52d352c8ad6e" target="44254ae2e038f93c570a69413d7f2f110c2950d1309ae4640fb36f273f285a5c" id="0598d72a3fe4520eae76e745cb2e4c4a7c3eb328367c8a8c72b7db05c2c1c269">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">a8892d3bcb48bcedf0ccb683dbe42846853d65a9c4526c3b0b419a4b99441ba6</data>
  <data key="d8">وافادت مصادر محلية ل"وفا"، ان قوات الاحتلال اعتقلت المواطنة بتول جمال من منزلها في قرية كفا جنوب طولكرم، والاسير المحرر عبد الفتاح عازم القدومي (57 عاما)، والاسير المحرر عمار مناع (63 عاما)، من مدينة طولكرم.</data>
</edge>
<edge source="2eb80f5f827cfa29e4a97eb9c1ded591e5095aa391de1961438a0c67358da7fc" target="97134d0e6d545233eee67fe6d3f742c4038b4ce9c4b938cbc7c19e786f7d0bed" id="da1ac9f20b745e9b0e2fa2f04be20d05904e722581ca4441fee91694e957be98">
  <data key="d5">born_in</data>
  <data key="d6">0.95</data>
  <data key="d7">3df3aafd9d59d66b110b7311895b7bfa8980c3f26d8cde5bd4f96f36fdcb8164</data>
  <data key="d8">تجدر الاشارة الي ان "ليانة بدر"، من ابرز الاصوات الروائية الفلسطينية، ولدت في القدس وتنقلت بين عدة عواصم عربية قبل ان تستقر في رام الله، نالت جائزة فلسطين للادب لعام 2024.</data>
</edge>
<edge source="2eb80f5f827cfa29e4a97eb9c1ded591e5095aa391de1961438a0c67358da7fc" target="8f1566a5852caedf343ce8454575a8722c5e26dbab0e916c362a1e8dbe3f91ba" id="4e92b6134627e0631a2e9f0e35033ccfe408184187d9cbba7da5c710a6f3b6d4">
