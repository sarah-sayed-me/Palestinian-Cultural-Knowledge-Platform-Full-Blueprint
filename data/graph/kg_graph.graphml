</edge>
<edge source="03716b3803549ce8cb4332a9a06065a4076e7cbe2e62069a5e8506d14c8daa9a" target="091310bfcd623c64a78576eb7180eea50beac4048da148b57abfb61027fa1c41" id="cde9044dc181594b464c38f5d13c789a72f72de726efaebb57865917a3c156c7">
  <data key="d5">located_in</data>
  <data key="d6">0.9</data>
  <data key="d7">91c0d63b0ed171a0de9e3a985dcf234c562f6071b1cbc288d62398e2be15db4e</data>
  <data key="d8">ابو شوشة: تقع الي الجنوب الشرقي من مدينة حيفا وتبعد عنها 25كم، ضمت اراضي القرية بعد هدمها عام 1948م البالغة مساحتها حوالي 9000 دونما الي (كيبوتس مشمار هعيمك) الذي تاسس عام 1926م، بلغ عدد سكانها عام 1922م حوالي 120 نسمة، ارتفع الي 720 عام 1945م.</data>
</edge>
<edge source="03716b3803549ce8cb4332a9a06065a4076e7cbe2e62069a5e8506d14c8daa9a" target="8431b54f35bbc978ee8f7c4d1c8ed1cfdee11b2762d8c97564b5605384650a6d" id="22530f96faf5707f3c1e2d410ae6104c60766bae0a52637092aa32a73d76ab7c">
