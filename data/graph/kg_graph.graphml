  <data key="d6">0.8</data>
  <data key="d7">d9897c43ab4bc62723c8093ead086d9c7552ff6bafaa8bd5f832a44ce0248b19</data>
  <data key="d8">مقرونة بالفدائي كما سلاحه وكان ايضا السبب الرئيسي لوضع الكوفية اخفاء ملامح الفدائي.</data>
</edge>
<edge source="5012a50989afca5d3c702130b8eea62bd872e33d6609e7eef9b2ca3f68697081" target="df0e1467b41668b9df6251d6113d85774100038fab2085906b0b7d011ca40c76" id="109c6c4a5acdb3cd11fca0ff7ea809bb8052773ab891c1abf51b602943f62be9">
  <data key="d5">wrote_about</data>
  <data key="d6">0.85</data>
  <data key="d7">caf369304b56af899dd21d9725f3df8759e3f731ef218f35d5d747407f5d1980</data>
  <data key="d8">ويمثل كتاب الباحث سليم عرفات المبيض "حلمي مصباح ابو شعبان: الاديب الشاعر والصحفي الثائر" الصادر في غزة عام 2004، مرجعا اساسيا في تحليل هذه الابعاد الفكرية والادبية لانتاج ابو شعبان الروائي والقصصي.</data>
</edge>
<edge source="5012a50989afca5d3c702130b8eea62bd872e33d6609e7eef9b2ca3f68697081" target="542c3e76eb961e10d7d3a067b56f590f4755e5b917f3a960f0d97417127ddc12" id="314794e70acf3493cf467dbd32e8e0d0c318eb5f54505082823cb24372d3e8ef">
