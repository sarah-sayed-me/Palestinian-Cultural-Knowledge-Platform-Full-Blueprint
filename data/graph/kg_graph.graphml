<edge source="ba2f5943a07b046e970d8305f382ca0b206fc20584cca4a744442e190eb0ab3a" target="92a4f41b590560917765206a6a81de9a02c2b73e0da7d8e6900fb9c2491509f2" id="7693c18c1972b321b2074eb6154d12c8c5af9c82ca96603fa945b6479746bb1e">
  <data key="d5">spoke_to</data>
  <data key="d6">0.85</data>
  <data key="d7">75bc98ced5e1d4af8498568a14cf02d39a6655f05a3e477ac73f0ab468c2c993</data>
  <data key="d8">بدوره قال الفنان المسرحي جوان جان لمراسلة سانا: ان اختيار مخيم اليرموك لاقامة ‏الندوة يمنحها رمزية خاصة لكونه منبرا فلسطينيا حيا يعكس صمود المجتمع، مؤكدا ان ‏الثقافة والفن جزء لا يتجزا من حياة الاهالي ومسيرة المقاومة الثقافية‎.</data>
</edge>
<edge source="ba2f5943a07b046e970d8305f382ca0b206fc20584cca4a744442e190eb0ab3a" target="2af920416a10afc108df82c97dd54d4ec9b702c311003ff6e84b919c18ae7b35" id="56d190279de0888f68a4570e978dbfd7d6a4608f109670af68140f8c9dc9b987">
