  <data key="d7">193611244cee3786513df2959efa909eb4f7f93cc0f516c5e6b08a5de7d68b34</data>
  <data key="d8">اكتسب ابو عرب موهبته الشعرية من جده لامه الشيخ علي الاحمد احد وجهاء قرية الشجرة الذي كان يكتب الشعر.</data>
</edge>
<edge source="c488bc2cb575980d59828ed8fc91496cdd7ba08478fa3fa20e39939efd891b1b" target="a1628feb70a8035f4a3ff702efe0c239a4e17e14f16d7906e8bb9903f8540425" id="49ae321d1b85cf233d310d7ea340df5b9a80664e8114363c752c55ccd9d7feba">
