  <data key="d6">0.8</data>
  <data key="d7">d9897c43ab4bc62723c8093ead086d9c7552ff6bafaa8bd5f832a44ce0248b19</data>
  <data key="d8">مقرونة بالفدائي كما سلاحه وكان ايضا السبب الرئيسي لوضع الكوفية اخفاء ملامح الفدائي.</data>
</edge>
<edge source="450ee004c3b33b7864cc881865b8ff5b1a9aab5a6f9e22b387a8de034159909e" target="c054c9ddafa30f28a02a09671ad8c502216f1139d5e48883be1d9bc6062b1c9c" id="def76a992ac04d97e0bb3c2f1d0fbd3223496287455c9f2fdec88f1f96772249">
