  <data key="d4">1</data>
</node>
<edge source="70f8a9e31404a4838e507c4ffd5125f5239a7edd674b0594957aeb53dd00641c" target="f0f1b5f1ce7e99a803f2155decf61093a56c92e1d232a4e9982940c58c51bf2a" id="0390faa7d2aa4634f4487d2fb51984246deb48493003e7c37278bd5b97896f4d">
  <data key="d5">related_to</data>
  <data key="d6">0.7</data>
  <data key="d7">acf5752d0b318ce81cbe4cfea729e4e4acdc3a10013acea7e5481f087484a4dc</data>
  <data key="d8">ولهذا ارتبطت بعض الحلي النسائية في فلسطين بالادخار والمهر والحالة الاجتماعية، الي جانب وظيفتها الجمالية.</data>
</edge>
<edge source="70f8a9e31404a4838e507c4ffd5125f5239a7edd674b0594957aeb53dd00641c" target="0432ece946a61c8b833130e2b1b34e3044388ac3fa01906d1c4328f484c612df" id="b1722f2da6e8ed9c5d427995d7000f83e82d31894d3a298a6d68b948cf0aea5a">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">97c160909d231f1b534d331bb46ace979e1944165348469df15d1cdc410dc7e4</data>
  <data key="d8">خلال حرب فلسطين عام 1948، فر او طرد نحو 700,000 فلسطيني عربي من ديارهم، اي 85 في المائة من مجموع السكان، الي الضفة الغربية وقطاع غزة والي بلدان لبنان وسوريا والاردن.</data>
</edge>
<edge source="70f8a9e31404a4838e507c4ffd5125f5239a7edd674b0594957aeb53dd00641c" target="68bc65dc430bb05c989edcacd4c1be32d389dcc44373eb92276fd5808ca00bd9" id="f615d5274365517355c11aa37d92860e4e38af544fec4e1856058635bdf17599">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">97c160909d231f1b534d331bb46ace979e1944165348469df15d1cdc410dc7e4</data>
  <data key="d8">خلال حرب فلسطين عام 1948، فر او طرد نحو 700,000 فلسطيني عربي من ديارهم، اي 85 في المائة من مجموع السكان، الي الضفة الغربية وقطاع غزة والي بلدان لبنان وسوريا والاردن.</data>
</edge>
<edge source="70f8a9e31404a4838e507c4ffd5125f5239a7edd674b0594957aeb53dd00641c" target="68bc65dc430bb05c989edcacd4c1be32d389dcc44373eb92276fd5808ca00bd9" id="c421ef948a2b9a41902f224ea4ddda00b8bf99127f9860590e401e41cfcb7274">
  <data key="d5">located_in</data>
  <data key="d6">0.85</data>
  <data key="d7">429b34399463f0d3e3e4cd3192ba830b567116d0b0d2ee427c238175b05464c6</data>
  <data key="d8">المسجد العمري الكبير: في صباح يوم الجمعة 8 ديسمبر 2023، تعرض المسجد العمري الكبير احد اقدم المساجد في فلسطين التاريخية للاستهداف من قبل قوات الاحتلال، حيث تعرض المسجد الواقع في مدينة غزة لقصف جوي اسرائيلي.</data>
</edge>
<edge source="70f8a9e31404a4838e507c4ffd5125f5239a7edd674b0594957aeb53dd00641c" target="542c3e76eb961e10d7d3a067b56f590f4755e5b917f3a960f0d97417127ddc12" id="809b89cc5fc2d5a87b8ce22ef0c40ef9621b9be1fea94bffc4e54f080e3c2109">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">97c160909d231f1b534d331bb46ace979e1944165348469df15d1cdc410dc7e4</data>
  <data key="d8">خلال حرب فلسطين عام 1948، فر او طرد نحو 700,000 فلسطيني عربي من ديارهم، اي 85 في المائة من مجموع السكان، الي الضفة الغربية وقطاع غزة والي بلدان لبنان وسوريا والاردن.</data>
</edge>
<edge source="70f8a9e31404a4838e507c4ffd5125f5239a7edd674b0594957aeb53dd00641c" target="542c3e76eb961e10d7d3a067b56f590f4755e5b917f3a960f0d97417127ddc12" id="9c7ce498d87397e78bfb8245eb0454903f5eb534609c277284522ebebd3f7522">
  <data key="d5">located_in</data>
  <data key="d6">0.85</data>
  <data key="d7">429b34399463f0d3e3e4cd3192ba830b567116d0b0d2ee427c238175b05464c6</data>
  <data key="d8">المسجد العمري الكبير: في صباح يوم الجمعة 8 ديسمبر 2023، تعرض المسجد العمري الكبير احد اقدم المساجد في فلسطين التاريخية للاستهداف من قبل قوات الاحتلال، حيث تعرض المسجد الواقع في مدينة غزة لقصف جوي اسرائيلي.</data>
</edge>
<edge source="70f8a9e31404a4838e507c4ffd5125f5239a7edd674b0594957aeb53dd00641c" target="97134d0e6d545233eee67fe6d3f742c4038b4ce9c4b938cbc7c19e786f7d0bed" id="b30c9c6be5645f94c60ecb1879d23b74baf26a91f4ab78402d2571816ff443ec">
  <data key="d5">located_in</data>
  <data key="d6">0.85</data>
  <data key="d7">07f310e1c4b6fa9806cdf1db76abe8f8e13a5e6d4e649716c42e4bebe71746ab</data>
  <data key="d8">لقد انتشرت حركة عمرانية بارزة في فلسطين بعد تلك الحملات، تاثرت بها البلاد حتي بعد خروجهم، فقد اشتهروا ببناء الكنائس وترميم ما تهدم منها، حيث تم بناء 60 كنيسة في القدس وحدها.</data>
</edge>
<edge source="70f8a9e31404a4838e507c4ffd5125f5239a7edd674b0594957aeb53dd00641c" target="8f1566a5852caedf343ce8454575a8722c5e26dbab0e916c362a1e8dbe3f91ba" id="e2e56fc545495a97555c3a0569f07c6cacb4d076ce02c4aaa64b86edb4efa012">
  <data key="d5">located_in</data>
  <data key="d6">0.85</data>
  <data key="d7">07f310e1c4b6fa9806cdf1db76abe8f8e13a5e6d4e649716c42e4bebe71746ab</data>
  <data key="d8">لقد انتشرت حركة عمرانية بارزة في فلسطين بعد تلك الحملات، تاثرت بها البلاد حتي بعد خروجهم، فقد اشتهروا ببناء الكنائس وترميم ما تهدم منها، حيث تم بناء 60 كنيسة في القدس وحدها.</data>
</edge>
<edge source="70f8a9e31404a4838e507c4ffd5125f5239a7edd674b0594957aeb53dd00641c" target="63e1e2b574c8825a829d1c4df044bb531198b96eebfbc678a5f9557c5df2ddb3" id="fa9bbc8a4d308ffba56bd24c2fd7f9d0f702bef1cb616d9850531910e3c814aa">
  <data key="d5">related_to</data>
  <data key="d6">0.8</data>
  <data key="d7">07f310e1c4b6fa9806cdf1db76abe8f8e13a5e6d4e649716c42e4bebe71746ab</data>
  <data key="d8">لقد تاثرت فلسطين بالنمط المعماري العثماني اكثر مما تاثرت بغيره في الحقبات الاستعمارية، وذلك لسببين: الاول الفترة الطويلة للحكم والذي استمر 400 عام، الي جانب العلاقة القوية بين فلسطين والاستانة، وهو ما تمثل بايلاء مدن دينية في فلسطين كالقدس اهمية خاصة حيث تبع بعض المدن في شكل مباشر الي الاستانة بسبب اهميتها الدينية والجغرافية ومركزيتها للعالمين الغربي والشرقي، وعلي راسها مدينة القدس ويافا وعكا ونابلس.</data>
</edge>
<edge source="70f8a9e31404a4838e507c4ffd5125f5239a7edd674b0594957aeb53dd00641c" target="5011ae503c4f568fb1183e5c5459245419ad2d2526b2a2826f682cd616272231" id="314468729abd062fe85ff396e7928bfecc155e30e64b9f55ab7f16dcbd4443b7">
  <data key="d5">related_to</data>
  <data key="d6">0.8</data>
  <data key="d7">07f310e1c4b6fa9806cdf1db76abe8f8e13a5e6d4e649716c42e4bebe71746ab</data>
  <data key="d8">لقد تاثرت فلسطين بالنمط المعماري العثماني اكثر مما تاثرت بغيره في الحقبات الاستعمارية، وذلك لسببين: الاول الفترة الطويلة للحكم والذي استمر 400 عام، الي جانب العلاقة القوية بين فلسطين والاستانة، وهو ما تمثل بايلاء مدن دينية في فلسطين كالقدس اهمية خاصة حيث تبع بعض المدن في شكل مباشر الي الاستانة بسبب اهميتها الدينية والجغرافية ومركزيتها للعالمين الغربي والشرقي، وعلي راسها مدينة القدس ويافا وعكا ونابلس.</data>
</edge>
<edge source="70f8a9e31404a4838e507c4ffd5125f5239a7edd674b0594957aeb53dd00641c" target="c67ee45e3f29c9c8519d8c2c3bf5eef6e223e8c38b7c9c528f2e851cebfd031b" id="92bef987cc15d28bd02d7e0e29aa742dd4b5212c3c00d6a270e5ac6f9930b9cb">
  <data key="d5">located_in</data>
  <data key="d6">0.85</data>
  <data key="d7">0fd5aecb34826710483906e41c147c220faaba9153562c2df43b056d89bd3329</data>
  <data key="d8">احتفالية فلسطين للادب مهرجان ادبي هو الاول من نوعه في الاراضي الفلسطينية اقيمت دورته الاولي عام 2008 في رام الله، وعدة مدن فلسطينية اخري منها القدس وبيت لحم، احتفالا بتراث فلسطين الثقافي، وتضامنا مع الشعب الفلسطيني في الذكري الستين للنكبة.</data>
</edge>
<edge source="70f8a9e31404a4838e507c4ffd5125f5239a7edd674b0594957aeb53dd00641c" target="acedfdecc00cce117b2e5f445440874ec876e6987600b1367d749f45013f1db0" id="014f3186a68befe664bd7219a18f4ff00281fc0b21d6f302088f9d18a1d4bc13">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">1f3c81b568302c92ac5a3c341b2d07a6351e88e64b47b47d0fa0f1b245f7cb9c</data>
  <data key="d8">نظمت سفارة دولة فلسطين لدي جمهورية مصر العربية حفل اطلاق كورال الاطفال الناجين من الحرب، وذلك للمرة الاولي في مصر، بالتعاون مع هيئة انقاذ الطفولة، في مبادرة تهدف الي دعم الاطفال الفلسطينيين الناجين من الحرب من ابناء قطاع غزة، من خلال الفن والموسيقي.</data>
</edge>
<edge source="70f8a9e31404a4838e507c4ffd5125f5239a7edd674b0594957aeb53dd00641c" target="586c54e067c9a594e7d3626da43b2c6d4eb0c926a921eed33f3f3bb4057c37c6" id="631744ddebd1b6c67a6f0a1c400fd95732b97ef081ebe6c8b0fd8f3a62ddaf67">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">1f3c81b568302c92ac5a3c341b2d07a6351e88e64b47b47d0fa0f1b245f7cb9c</data>
  <data key="d8">نظمت سفارة دولة فلسطين لدي جمهورية مصر العربية حفل اطلاق كورال الاطفال الناجين من الحرب، وذلك للمرة الاولي في مصر، بالتعاون مع هيئة انقاذ الطفولة، في مبادرة تهدف الي دعم الاطفال الفلسطينيين الناجين من الحرب من ابناء قطاع غزة، من خلال الفن والموسيقي.</data>
</edge>
<edge source="70f8a9e31404a4838e507c4ffd5125f5239a7edd674b0594957aeb53dd00641c" target="f68e44fa74f8908723a6a1fa9ed4d794a6f2bcf882cad328ecd7c126e33695a2" id="17f8255e8a644467f49e0c51f7f115b718d1b0d5862e60ec72a3f9d2e6a96c2d">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">1f3c81b568302c92ac5a3c341b2d07a6351e88e64b47b47d0fa0f1b245f7cb9c</data>
  <data key="d8">نظمت سفارة دولة فلسطين لدي جمهورية مصر العربية حفل اطلاق كورال الاطفال الناجين من الحرب، وذلك للمرة الاولي في مصر، بالتعاون مع هيئة انقاذ الطفولة، في مبادرة تهدف الي دعم الاطفال الفلسطينيين الناجين من الحرب من ابناء قطاع غزة، من خلال الفن والموسيقي.</data>
</edge>
<edge source="70f8a9e31404a4838e507c4ffd5125f5239a7edd674b0594957aeb53dd00641c" target="144d907f3318a424e692ff2d42694facc96448b9efade8bdba3f3f71094fd9ca" id="4f40176ce70de30496a8f2137c0ac662cd96982e248480540288179bf2e04976">
  <data key="d5">cooperates_with</data>
  <data key="d6">0.85</data>
  <data key="d7">10f72a1e03b624632fdf02724971420328c69883929520feb77870f02a72d583</data>
  <data key="d8">اعلنت وزارة السياحة والاثار الفلسطينية ، اليوم الخميس، عن اعتماد تسجيل 12 موقعا فلسطينيا جديدا علي القائمة التمهيدية للتراث العالمي لدي منظمة الامم المتحدة للتربية والعلم والثقافة (اليونسكو)، بالتعاون مع المندوبية الدائمة لدولة فلسطين لدي اليونسكو، ليرتفع بذلك عدد المواقع الفلسطينية المدرجة علي القائمة التمهيدية الي 23 موقعا وفقا لما نقلته وكالة "وفا".</data>
</edge>
<edge source="70f8a9e31404a4838e507c4ffd5125f5239a7edd674b0594957aeb53dd00641c" target="dedbcda9c3fd8f3fea32ef8960f48b4004e8f11aa095f1de3d291c947576b725" id="338ac64d527cb43a2b30ce21cb95d56779ee53f3cdb779dae92fd56ab018ac2e">
  <data key="d5">member_of</data>
  <data key="d6">0.8</data>
  <data key="d7">56ef7a665d767d239f588fd708f2e466934f4e796c3cb5c15a3a526d0ae8131f</data>
  <data key="d8">شاركت دولة فلسطين ممثلة بامين عام اللجنة الوطنية الفلسطينية للتربية والثقافة والعلوم جهاد رمضان، في اعمال الدورة السادسة والاربعين للمجلس التنفيذي لمنظمة العالم الاسلامي للتربية والعلوم والثقافة "ايسيسكو"، المنعقدة في مقر المنظمة بالعاصمة المغربية الرباط، برئاسة رئيس المجلس التنفيذي دواس دواس، وحضور المدير العام للمنظمة سالم بن محمد المالك.</data>
</edge>
<edge source="70f8a9e31404a4838e507c4ffd5125f5239a7edd674b0594957aeb53dd00641c" target="0a55d2608851f9378103298e036d22ae01b47d52eb8c49c0ca07ed39d3e1c450" id="1ce08ccd5d46587246ac6c04cea8c94873dbe3ceb6a128c0a10dd00510a1bc6e">
  <data key="d5">participated_in</data>
  <data key="d6">0.9</data>
  <data key="d7">56ef7a665d767d239f588fd708f2e466934f4e796c3cb5c15a3a526d0ae8131f</data>
  <data key="d8">شاركت دولة فلسطين ممثلة بامين عام اللجنة الوطنية الفلسطينية للتربية والثقافة والعلوم جهاد رمضان، في اعمال الدورة السادسة والاربعين للمجلس التنفيذي لمنظمة العالم الاسلامي للتربية والعلوم والثقافة "ايسيسكو"، المنعقدة في مقر المنظمة بالعاصمة المغربية الرباط، برئاسة رئيس المجلس التنفيذي دواس دواس، وحضور المدير العام للمنظمة سالم بن محمد المالك.</data>
</edge>
<edge source="70f8a9e31404a4838e507c4ffd5125f5239a7edd674b0594957aeb53dd00641c" target="fd5f80743f28f2f170c17bd3ddf046cad463871a69bebf23529f4de2da65e3ca" id="ef2bb413bb75392b421ecb365d1cedcb622f84d27c4d1ea5c6081df41780777b">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">45dba9cdcd23cccad42d9b28abe173935905572acf43e3330805fd9915634cea</data>
  <data key="d8">وكان المهرجان، انطلق في 15 مايو الماضي في فلسطين بين خيام النزوح، في مشهد حمل رمزية قوية تعكس حجم المعاناة التي تعرض لها ابناء الشعب الفلسطيني في قطاع غزة؛</data>
</edge>
<edge source="c054c9ddafa30f28a02a09671ad8c502216f1139d5e48883be1d9bc6062b1c9c" target="dc1cb5788eefa6baebfbdefad2ccb5091b139b8b1bcf80c967399cf3d8ede6cb" id="a828fd98484bc81ac773cbddcd1527fd8b652ee0e4f5312792ebc4889523b8ec">
  <data key="d5">controls</data>
  <data key="d6">0.8</data>
  <data key="d7">aef633dc6d2746f906eac02bf55daa5657989d328a0bb2ebcc182a85f9882d1e</data>
  <data key="d8">تقوم علي حدود المنطقة التاريخية اليوم عدة كيانات سياسية متراكبة: دولة اسرائيل (التي اقيمت في حرب 1948 بعد تهجير مئات الاف الفلسطينيين من وطنهم) والضفة الغربية وقطاع غزة التي احتلتها اسرائيل في حرب عام 1967.</data>
</edge>
<edge source="c054c9ddafa30f28a02a09671ad8c502216f1139d5e48883be1d9bc6062b1c9c" target="68bc65dc430bb05c989edcacd4c1be32d389dcc44373eb92276fd5808ca00bd9" id="be19b35b977c14b134c3063c83643d1304e0c8c1bfdd6e2b29d810b21286ae31">
  <data key="d5">occupied_in</data>
  <data key="d6">0.8</data>
  <data key="d7">aef633dc6d2746f906eac02bf55daa5657989d328a0bb2ebcc182a85f9882d1e</data>
  <data key="d8">تقوم علي حدود المنطقة التاريخية اليوم عدة كيانات سياسية متراكبة: دولة اسرائيل (التي اقيمت في حرب 1948 بعد تهجير مئات الاف الفلسطينيين من وطنهم) والضفة الغربية وقطاع غزة التي احتلتها اسرائيل في حرب عام 1967.</data>
</edge>
<edge source="c054c9ddafa30f28a02a09671ad8c502216f1139d5e48883be1d9bc6062b1c9c" target="542c3e76eb961e10d7d3a067b56f590f4755e5b917f3a960f0d97417127ddc12" id="72001e69373766b284763d1aba438e0f3edd0a64fbdaba434b69d2adc58314e5">
  <data key="d5">occupied_in</data>
  <data key="d6">0.8</data>
  <data key="d7">aef633dc6d2746f906eac02bf55daa5657989d328a0bb2ebcc182a85f9882d1e</data>
  <data key="d8">تقوم علي حدود المنطقة التاريخية اليوم عدة كيانات سياسية متراكبة: دولة اسرائيل (التي اقيمت في حرب 1948 بعد تهجير مئات الاف الفلسطينيين من وطنهم) والضفة الغربية وقطاع غزة التي احتلتها اسرائيل في حرب عام 1967.</data>
</edge>
<edge source="c054c9ddafa30f28a02a09671ad8c502216f1139d5e48883be1d9bc6062b1c9c" target="3adf79f6d36479f5a900db3cb0eca995ddb3d5241e8fdf57874c1ca201bbb592" id="e540c59102f6f6272b5bc8fab2edd2ff7880969f4b6120c9f41d1b8e61678af0">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">336759792868896465e42aa9f314214111f6040d79afc098bc43813f421fc153</data>
  <data key="d8">ولم يكن هناك قتال في القرية، ولكن بعد سقوط صفد في يد اسرائيل ومن «حملة همس» قام بها زعماء يهود محليون الي رؤساء القري العربية (مخاتير) لتحذيرهم من التعزيزات اليهودية الضخمة التي وصلت الي الجليل، فر سكان ابل القمح.</data>
</edge>
<edge source="68bc65dc430bb05c989edcacd4c1be32d389dcc44373eb92276fd5808ca00bd9" target="f326837b80c9b9cf3f97f1ab19494ebbe761bba502efed7abee279ea9ec1c51b" id="d085aebbe02e73725491538183ba4ad6f1ca3cf431bbc26ee8c05ea2c0f3aeba">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">aef633dc6d2746f906eac02bf55daa5657989d328a0bb2ebcc182a85f9882d1e</data>
  <data key="d8">في عام 2007، ادي انقسام السلطة السياسية في مناطق الحكم الذاتي الي نشوء سلطة في قطاع غزة واخري في مدن الضفة.</data>
</edge>
<edge source="542c3e76eb961e10d7d3a067b56f590f4755e5b917f3a960f0d97417127ddc12" target="f326837b80c9b9cf3f97f1ab19494ebbe761bba502efed7abee279ea9ec1c51b" id="911eae35441f36c773ae42adf1f983ab0952b1d00507ac12d9d8e82e3fee3ba7">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">aef633dc6d2746f906eac02bf55daa5657989d328a0bb2ebcc182a85f9882d1e</data>
  <data key="d8">في عام 2007، ادي انقسام السلطة السياسية في مناطق الحكم الذاتي الي نشوء سلطة في قطاع غزة واخري في مدن الضفة.</data>
</edge>
<edge source="0432ece946a61c8b833130e2b1b34e3044388ac3fa01906d1c4328f484c612df" target="8f901793d568460f1e1409b777a0c3e30344c2faf6a8d7adad642c6a3cdf3659" id="31ef2f03f0e9c059fcefa954a8a7d3bc02a69ff7f7bce7f0f150098d7bebfe1d">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">0fd5aecb34826710483906e41c147c220faaba9153562c2df43b056d89bd3329</data>
  <data key="d8">كذلك عدد كبير من طلاب جامعات فلسطينية كجامعة بيرزيت وجامعة بيت لحم، حيث تتم هذه الفعاليات في عدة مراكز ثقافية فلسطينية في الضفة الغربية منها المسرح الوطني الفلسطيني - القدس، ومسرح القصبة - رام الله، ودار الندوة - بيت لحم، ومتحف دار الطفل العربي - القدس، ومسرح الحرية - جنين.</data>
</edge>
<edge source="0432ece946a61c8b833130e2b1b34e3044388ac3fa01906d1c4328f484c612df" target="e6a3f1ac09eed0b457f2db0fc9f443102bf0ca1e9104b2189db8b93ca42a15e8" id="1d0c70a1ae05fd948933b04c77f9ff5ea313fc2ceb8b1a4fe8be1529a5ba841b">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">d83cb6e1821693d082fd9d3d84fddab5f2ad82beac2d1e97effa3bc70b6423f4</data>
  <data key="d8">واشارت وزارة السياحة والاثار الي مواقع، بينها سبسطية شمالي الضفة الغربية المحتلة، وبرك سليمان جنوب بيت لحم، والحرم الابراهيمي في الخليل.</data>
</edge>
<edge source="0432ece946a61c8b833130e2b1b34e3044388ac3fa01906d1c4328f484c612df" target="f56621a8108f1cfc69780f0373c1ebef62d881e779c809ac330a291debf0b853" id="d24eb8edba3ceb86c22a72848081b8ad24c846ff1c72ef927b8e179bcce9bb70">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">d83cb6e1821693d082fd9d3d84fddab5f2ad82beac2d1e97effa3bc70b6423f4</data>
  <data key="d8">واشارت وزارة السياحة والاثار الي مواقع، بينها سبسطية شمالي الضفة الغربية المحتلة، وبرك سليمان جنوب بيت لحم، والحرم الابراهيمي في الخليل.</data>
</edge>
<edge source="091310bfcd623c64a78576eb7180eea50beac4048da148b57abfb61027fa1c41" target="f8ac1b3eb432acbc891068e2cdd7d92cfacdc8a5ab018508811831478116b7b4" id="81963a2fff128fabe14c799a8c22c49f548c8eb0304756f29fbbdc4dd9475c04">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">91c0d63b0ed171a0de9e3a985dcf234c562f6071b1cbc288d62398e2be15db4e</data>
  <data key="d8">اجزم: تقع الي الجنوب من حيفا وتبعد عنها 28 كم، ازالتها سلطات الاحتلال عام 1948م، واقامت علي اراضيها والبالغة مساحتها 46900 دونما مستوطنة (موشاف كيريم مهرال) التي اقيمت عام 1926م، بلغ عدد سكانها عام 1922م حوالي 1610 نسمة ارتفع الي 2160 نسمة عام 1931، والي 2970 نسمة عام 1945م.</data>
</edge>
<edge source="232775d96512820d5c31875b58c6c04d1e2fe2139728c24c15cd889577f7a373" target="8e645df11b49e6a7491b2a0a12d611aecacde68298447936f944ecf94c2345a3" id="d437c6a6cb587da5e481a7f44fba86bfc6c5e387408152f5f80a978d8c8aa27d">
  <data key="d5">associated_with</data>
  <data key="d6">0.85</data>
  <data key="d7">d9897c43ab4bc62723c8093ead086d9c7552ff6bafaa8bd5f832a44ce0248b19</data>
  <data key="d8">اعتاد الفلاح ان يضع الكوفية لتجفيف عرقه اثناء حراثة الارض ولوقايته من حر الصيف وبرد الشتاء، ارتبط اسم الكوفية بالكفاح الوطني منذ ثورة 1936 في فلسطين، حيث تلثم الفلاحون الثوار بالكوفية لاخفاء ملامحهم اثناء مقاومة القوات البريطانية في فلسطين</data>
</edge>
<edge source="232775d96512820d5c31875b58c6c04d1e2fe2139728c24c15cd889577f7a373" target="8f1566a5852caedf343ce8454575a8722c5e26dbab0e916c362a1e8dbe3f91ba" id="c8078ecaae71b887a3a4f79212477b32ad759ca6cac9af83e6da7b89705d0620">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">07f310e1c4b6fa9806cdf1db76abe8f8e13a5e6d4e649716c42e4bebe71746ab</data>
  <data key="d8">يعتبر الحجر الطبيعي مادة البناء الرئيسية في فلسطين، كما يعتبر حجر القدس احد الانواع الشائعة منه في المنطقة.</data>
</edge>
<edge source="232775d96512820d5c31875b58c6c04d1e2fe2139728c24c15cd889577f7a373" target="eb6047ab6843c973bc6101b161720b72016d7e826fb241de6d3fe796d6f2b711" id="853b43dc3433dde0d9c43a381009bb9ea8ec05e579723fe9f74ed050919aecbc">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">2c3bd17190548e7fc1a9a55f60d317e8b760c76d58be2e14b893cb583b3cb27d</data>
  <data key="d8">وتقام هذه الفعالية سنويا في شارع فلسطين، الذي اصبح رمزا لحضور الجالية الفلسطينية، وتاثيرها المتزايد في ولاية نيوجيرسي.</data>
</edge>
<edge source="9a7a77f3068b2b57fe67db5ffbc1b56c9c057cd81cd3ab67888cfeb57ce61b79" target="984f0e11a378f7caa78e4aa4f8f13cca10ee2ef8b708abb88b60533aa0b83423" id="a1696bb67ec954793516932e4078e98bb9f11cc7c9020cd2d2349ac65df05562">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">a36f40b2fea80a16fc4fbefaa27121fd0df6ea77d5bca026db9e19431b014981</data>
  <data key="d8">من جهته، ادان محافظ نابلس غسان دغلس احراق مسجد الرحمة في بلدة قصرة جنوب نابلس، مؤكدا ان استهداف دور العبادة والمقدسات الدينية يمثل جريمة خطيرة وانتهاكا صارخا لكل القوانين والاعراف الدولية والانسانية .</data>
</edge>
<edge source="9a7a77f3068b2b57fe67db5ffbc1b56c9c057cd81cd3ab67888cfeb57ce61b79" target="34933870887a8d7db487eabd0cf94021fd4e8b05de66d1dfe4cdf3796919c132" id="ab19deb3ad0f30020c007b53994097cc160fb7d484b5c9278d9161cac2828c76">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">a36f40b2fea80a16fc4fbefaa27121fd0df6ea77d5bca026db9e19431b014981</data>
  <data key="d8">واكد محافظ نابلس تضامن محافظة نابلس الكامل مع اهالي بلدة قصرة، ورفضها المطلق لكل اشكال الاعتداء علي دور العبادة والمقدسات الدينية .</data>
</edge>
<edge source="4356e541b3e7eec330c1c10f71d9cd8435a3309566c33fe9473e05279adb58d2" target="734de0e7cda00d472c4dad60dfc769a52d2a02bc2f38a590a9540ad490fb480c" id="e4b7976820b5f85723b883c4205293fa9d999586d2ffd4efd04d95e2063a7447">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">aaf5c99209cc784a4fb32e92739bb6f9b99b0dc25804008aed27cc52a6448bad</data>
  <data key="d8">رام الله 26-7-2026 وفا – اصيب عدد من العاملين، صباح اليوم الاحد، جراء اعتداء مستعمرين عليهم في بلدة كفر مالك شرق رام الله، واضرموا النار في معدات ثقيلة .</data>
</edge>
<edge source="4356e541b3e7eec330c1c10f71d9cd8435a3309566c33fe9473e05279adb58d2" target="710f17abe31d379e66bf74d338e143490593f86ba8bd633e1efbf648bfd6e14d" id="cd924ae6e7aaa0dead3e3f7ed81fae5a5a4362e105422f8bc78c0fdb71c6a1e0">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">3df3aafd9d59d66b110b7311895b7bfa8980c3f26d8cde5bd4f96f36fdcb8164</data>
  <data key="d8">تقول احدي شخصيات الرواية «لم يعد هناك في رام الله الا الترحم علي شهداء الانتفاضتين، لا يوجد فيها ما يرضي الروح من اشكال نضالنا القديم سوي ضريح القائد الرمز ومتحف محمود درويش.</data>
</edge>
<edge source="a86f40d31dbda4d89150167ddd7a683a59c50b8d1ea19e30aa8611968d2795a1" target="984f0e11a378f7caa78e4aa4f8f13cca10ee2ef8b708abb88b60533aa0b83423" id="47f47e4512cdca91c8d59675b46c023fbb0229fdefeae8b7cd34267a16148f15">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">a36f40b2fea80a16fc4fbefaa27121fd0df6ea77d5bca026db9e19431b014981</data>
  <data key="d8">من جهته، ادان محافظ نابلس غسان دغلس احراق مسجد الرحمة في بلدة قصرة جنوب نابلس، مؤكدا ان استهداف دور العبادة والمقدسات الدينية يمثل جريمة خطيرة وانتهاكا صارخا لكل القوانين والاعراف الدولية والانسانية .</data>
</edge>
<edge source="a86f40d31dbda4d89150167ddd7a683a59c50b8d1ea19e30aa8611968d2795a1" target="34933870887a8d7db487eabd0cf94021fd4e8b05de66d1dfe4cdf3796919c132" id="ef06a0169c4d90f236ede38a9dee7ed1aff074c0a2ce51c7e77364da5767d3e2">
  <data key="d5">located_in</data>
