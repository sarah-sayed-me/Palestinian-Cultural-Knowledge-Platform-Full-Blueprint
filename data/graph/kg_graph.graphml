  <data key="d7">5417a697d8b5f24bab452bb2551b78ba627df74a239d0c5deb401fc2114e6171</data>
  <data key="d8">سارة حجازي، الباحثة بادارة الوعي الاثري بالقاهرة التاريخية.</data>
</edge>
<edge source="f0678b47f3b823f0d2be39436080907a8867e0876e0f42bb087b4dc845593108" target="8f11d5b1c60e65f426c52282703fc350c13628ac9f73f8ec0d5f915409e0a864" id="bd376df62cfc7da5df320e99cc8a23e98dfa6ffd907affb4b2283c945990c977">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">5417a697d8b5f24bab452bb2551b78ba627df74a239d0c5deb401fc2114e6171</data>
  <data key="d8">وفي اجندة الدستور الثقافية اليوم ايضا، يستقبل مسرح سيد دويش- اوبرا اسكندرية، في السابعة مساء، حفلا للواعدين بمركز تنمية المواهب، لفصلي الاوركسترا والايقاع الشرقي.</data>
</edge>
<edge source="acee2fb0887f421f17b344aac02f30e4930e7efe5e14d0870334fa30f5826589" target="0958366bfcfd1f071095a99ef2ce09a6a1ceb6f48dae23791144d8b2a7a52e67" id="e33ffacead9d17baa9ee888f0edeb7774f2ea8e19e6c6f264d6f0ec41640df2c">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">124f19e094f13e1ba0ebfe4959419f3f24d807485ac7e35127d6e3a75a75bf7e</data>
  <data key="d8">العرض المسرحي من انتاج مركز طابو، برعاية السفارة الفلسطينية بالقاهرة، وتستضيفه اللجنة الثقافية والفنية بجهود من الكاتب الصحفي هيثم الهواري، ويشارك في بطولته: لينا السوسي، ليان عيد، تولين عيد، ليان ابو صيام، مريم مطر، نور ماضي، رود ماضي، نور عقيل، يامن عقيل، وجود عبيد.</data>
</edge>
<edge source="acee2fb0887f421f17b344aac02f30e4930e7efe5e14d0870334fa30f5826589" target="db39434cbdc1e543ec6bb491923fd1b566b86e7ed884110118e673805e71dd72" id="e0f11e8a5c8947ad071f4d50c8ed021982cf9501d2610fba3a58c18f24b4177e">
  <data key="d5">produced_in</data>
  <data key="d6">0.8</data>
  <data key="d7">124f19e094f13e1ba0ebfe4959419f3f24d807485ac7e35127d6e3a75a75bf7e</data>
  <data key="d8">العرض المسرحي من انتاج مركز طابو، برعاية السفارة الفلسطينية بالقاهرة، وتستضيفه اللجنة الثقافية والفنية بجهود من الكاتب الصحفي هيثم الهواري، ويشارك في بطولته: لينا السوسي، ليان عيد، تولين عيد، ليان ابو صيام، مريم مطر، نور ماضي، رود ماضي، نور عقيل، يامن عقيل، وجود عبيد.</data>
</edge>
<edge source="26f78107f3ca238ba77bbf8661e707b0395c3867334a599251f8135fb0b57e73" target="dedbcda9c3fd8f3fea32ef8960f48b4004e8f11aa095f1de3d291c947576b725" id="073a9bef8b9df94ef7b7649cd284ca0d4b51986abe151587991f696898f8710b">
  <data key="d5">member_of</data>
  <data key="d6">0.8</data>
  <data key="d7">56ef7a665d767d239f588fd708f2e466934f4e796c3cb5c15a3a526d0ae8131f</data>
  <data key="d8">شاركت دولة فلسطين ممثلة بامين عام اللجنة الوطنية الفلسطينية للتربية والثقافة والعلوم جهاد رمضان، في اعمال الدورة السادسة والاربعين للمجلس التنفيذي لمنظمة العالم الاسلامي للتربية والعلوم والثقافة "ايسيسكو"، المنعقدة في مقر المنظمة بالعاصمة المغربية الرباط، برئاسة رئيس المجلس التنفيذي دواس دواس، وحضور المدير العام للمنظمة سالم بن محمد المالك.</data>
</edge>
<edge source="6d019f68de4dcd6b878fc22705d60a2003d23368168b7b3af62dc6a8d5789082" target="eb6047ab6843c973bc6101b161720b72016d7e826fb241de6d3fe796d6f2b711" id="2310294fe56692f002de8271db2d0a28b9257079749c5980de72fa6de87c0c70">
  <data key="d5">located_in</data>
  <data key="d6">0.95</data>
  <data key="d7">2c3bd17190548e7fc1a9a55f60d317e8b760c76d58be2e14b893cb583b3cb27d</data>
  <data key="d8">شهدت مدينة "باترسون" في ولاية "نيوجيرسي" الامريكية، امس الاحد، فعاليات جماهيرية واسعة ضمن النسخة الخامسة من "يوم فلسطين"، في الشارع الذي يحمل اسم فلسطين وسط المدينة.</data>
</edge>
<edge source="6d019f68de4dcd6b878fc22705d60a2003d23368168b7b3af62dc6a8d5789082" target="70f8a9e31404a4838e507c4ffd5125f5239a7edd674b0594957aeb53dd00641c" id="4fbdad67ed2a507d8e4b0f485554a8fc8159c5c180ec00594ca89658c33dc2a4">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">2c3bd17190548e7fc1a9a55f60d317e8b760c76d58be2e14b893cb583b3cb27d</data>
  <data key="d8">شهدت مدينة "باترسون" في ولاية "نيوجيرسي" الامريكية، امس الاحد، فعاليات جماهيرية واسعة ضمن النسخة الخامسة من "يوم فلسطين"، في الشارع الذي يحمل اسم فلسطين وسط المدينة.</data>
</edge>
<edge source="2ee636395ca5bdf82110c837a66a5fefc68d2099ba3fa69fed007097920055dc" target="ab69bc84acae4daaf203fa03e3ccdf8d35c37a2dc217121092d63cc185122d60" id="f107169b822e0b143d7a45e0ed728abd55b97a6c6930540136a13665f5bf423c">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">30fb5877217efcfc87ea9fd8a238daf9316fc788cbfafeb586656434b7450667</data>
  <data key="d8">بوابة جريدة الوسط»، بوابة الكترونية ليبية مستقلة ملتزمة في ادائها المهني بالانظمة الاعلامية السارية، وهدفها تقديم خدمة اعلامية مستنيرة ترتكز الي الصدقية والدقة والحياد، واحترام الحرية الشخصية، وصولا الي ان تكون «صوت ليبيا الدولي</data>
</edge>
<edge source="b56bd677282194b5b0335a70faf1c5bc1083471bd4763272dc76df1782dd3109" target="dd76221d4533eb36f63c6b115718e50b2fa8d0077fe6c7bf158a760d854f6a74" id="5b65ffd7b157829b24716b9db7790091ccd61ba34143f062d308b3eeaf3d5335">
  <data key="d5">child_of</data>
  <data key="d6">0.95</data>
  <data key="d7">30fb5877217efcfc87ea9fd8a238daf9316fc788cbfafeb586656434b7450667</data>
  <data key="d8">وقالت سعيد، وهي ابنة المفكر الفلسطيني الراحل ادوارد سعيد، ان والدها كان سيشعر بالفخر تجاه عدد من الطلاب المشاركين في الاحتجاجات، مشيرة الي ان ما شاهدته خلال زيارتها للموقع اتسم بالسلمية والتنظيم.</data>
</edge>
<edge source="1865f4039e941aa5a1e6e872a4d21d6cff7208fcc2b0721ce7da8fb9ea18e370" target="47b50eca5bbb3820c7827254c669c01051cde0b4386d8ed000327124d52b76d1" id="b28a66252362eb3461ec4307d0a12adff15d80efc01d85889d8ccba924201294">
  <data key="d5">born_in</data>
  <data key="d6">0.8</data>
  <data key="d7">30fb5877217efcfc87ea9fd8a238daf9316fc788cbfafeb586656434b7450667</data>
  <data key="d8">عن نجلاء سعيد وتعد نجلا سعيد كاتبة ومسرحية وممثلة اميركية من اصول فلسطينية، عرفت باعمالها الادبية والمسرحية التي تتناول قضايا الهوية والانتماء والثقافة العربية في الولايات المتحدة، كما انها ابنة المفكر والاكاديمي الفلسطيني البارز ادوارد سعيد، احد ابرز الاصوات الفكرية في دراسة الاستشراق والنقد الثقافي المعاصر.</data>
</edge>
<edge source="1865f4039e941aa5a1e6e872a4d21d6cff7208fcc2b0721ce7da8fb9ea18e370" target="dd76221d4533eb36f63c6b115718e50b2fa8d0077fe6c7bf158a760d854f6a74" id="792d63848bfb7b9036f2a724c84835f1477ac3a285f85f8cf36ae6d8aa5a40d6">
  <data key="d5">child_of</data>
  <data key="d6">0.95</data>
  <data key="d7">30fb5877217efcfc87ea9fd8a238daf9316fc788cbfafeb586656434b7450667</data>
  <data key="d8">عن نجلاء سعيد وتعد نجلا سعيد كاتبة ومسرحية وممثلة اميركية من اصول فلسطينية، عرفت باعمالها الادبية والمسرحية التي تتناول قضايا الهوية والانتماء والثقافة العربية في الولايات المتحدة، كما انها ابنة المفكر والاكاديمي الفلسطيني البارز ادوارد سعيد، احد ابرز الاصوات الفكرية في دراسة الاستشراق والنقد الثقافي المعاصر.</data>
</edge>
<edge source="61e6da90ec7879c038d6de0481c86293ac74dd1a84df3c4d5abb3afb8d27727a" target="6c013b02c79e39af9eb527326c3e236da8f92aae1532bed01f7e2dd4712f0612" id="fbeee2aafdc87aff53cf75f574905af2ee85d61d2e2f1c80b7966ddcbe29729c">
  <data key="d5">associated_with</data>
  <data key="d6">0.8</data>
  <data key="d7">5fba38e6bc5b4aaa440d66f7e437f19964c4128c07b731b91ea7bead86c13b7b</data>
  <data key="d8">وعلي مدار ساعة ونصف من الزمن، عاشت الجماهير حالة استثنائية من التفاعل والانبهار، حيث امتزجت الاغاني التراثية الفلسطينية باصوات جوقة بيات وابداع الموسيقي درويش درويش، لتتحول القاعة الي فضاء نابض بالفرح، والحماس، والحنين، والتصفيق المتواصل، في تجربة فنية وصفها كثيرون بانها من ابرز الاحداث الثقافية التي شهدها المجتمع العربي في السنوات الاخيرة والتي روفقت بالاثواب التراثية المطرزة والمميزة، ليكون المهرجان اروع احياء ليوم الزي التراثي وتنفرد به مدينة كفر قرع.</data>
</edge>
<edge source="8ddc613048c604b00680d7e8515dd8cb43da90511460df8b5ae732dffaa48160" target="07f9371a751afea1ba8b72982e01f02d91b6ab4f88fc9d921eb41067e8b61dc2" id="00dba9ba231477f72667b91bf561da54818c7b7857f4a41309ab11467929065f">
  <data key="d5">member_of</data>
  <data key="d6">0.8</data>
  <data key="d7">5fba38e6bc5b4aaa440d66f7e437f19964c4128c07b731b91ea7bead86c13b7b</data>
  <data key="d8">كما قام المحامي فراس احمد بدحي رئيس البلدية بتكريم السيد لورنس خميسة مدير جوقة بيات والموسيقار مايسترو بيات الفنان درويش درويش والسيد عماد مداح مدير الانتاج علي اختيار كفر قرع لتكون انطلاقة العرض للعالم الموسيقي والعربي والمجتمع العربي.</data>
</edge>
<edge source="884bada24c3c7780a551dfcdbfa84343b429307af8bb2c96ad7b52ad90838c33" target="d8fd5d2cf9cd9d093065895fe2190964d9b7c22bb8dbff6642103f1ebbbcd60a" id="4cb3e48becace3f516cf037ed477d729d5d2749e08f351a4693e492040c0b6f3">
  <data key="d5">related_to</data>
  <data key="d6">0.85</data>
  <data key="d7">5fba38e6bc5b4aaa440d66f7e437f19964c4128c07b731b91ea7bead86c13b7b</data>
  <data key="d8">واستهلت الامسية مديرة القصر الثقافي السيدة مها زحالقة مصالحة بكلمة افتتاحية استثنائية نسجت فيها، بلغة ادبية اسرة، العلاقة الوثيقة بين الثوب الفلسطيني المطرز، والصمود، والهوية، وعراقة الاجداد والجذور، مؤكدة ان كل غرزة في هذا الثوب تحمل حكاية وطن، وان التراث ليس ماضيا يروي، بل حاضر يعاش ومستقبل يصان، فشكلت كلماتها مدخلا وجدانيا عميقا مهد لامسية بقيت راسخة في ذاكرة الحاضرين مؤكدة ان التراث هو شباك الروح الذي يطل علي فردوس الجذور والعراقة والاصالة، مستطردة للتاكيد ان البعد الرمزي لاختيار العرض الغنائي "نغمة اصل" في يوم الزي التراثي هو عظيم وتنفرد به كفر قرع لتكون السباقة لهذه المبادرة التي الهبت الجماهير وملات فضاءات القاعة حبا وحماسا وفرحا وتراثا، كما بعثت مديرة القصر الثقافي بتحية لروح فنان التراث الراحل الفنان شفيق كبها والراحل يوسف ابو ليل، الفنان حميد ابو ليل والفنان صالح ابو ليل مؤكدة دور كفر قرع الريادي في ترسيخ التراث والفن العريق.</data>
</edge>
<edge source="884bada24c3c7780a551dfcdbfa84343b429307af8bb2c96ad7b52ad90838c33" target="6c013b02c79e39af9eb527326c3e236da8f92aae1532bed01f7e2dd4712f0612" id="ffa0c58346fe8617e4eda64e08f66866209b37a3a75ce5f923f2c83946838abb">
  <data key="d5">related_to</data>
  <data key="d6">0.8</data>
  <data key="d7">5fba38e6bc5b4aaa440d66f7e437f19964c4128c07b731b91ea7bead86c13b7b</data>
  <data key="d8">واستهلت الامسية مديرة القصر الثقافي السيدة مها زحالقة مصالحة بكلمة افتتاحية استثنائية نسجت فيها، بلغة ادبية اسرة، العلاقة الوثيقة بين الثوب الفلسطيني المطرز، والصمود، والهوية، وعراقة الاجداد والجذور، مؤكدة ان كل غرزة في هذا الثوب تحمل حكاية وطن، وان التراث ليس ماضيا يروي، بل حاضر يعاش ومستقبل يصان، فشكلت كلماتها مدخلا وجدانيا عميقا مهد لامسية بقيت راسخة في ذاكرة الحاضرين مؤكدة ان التراث هو شباك الروح الذي يطل علي فردوس الجذور والعراقة والاصالة، مستطردة للتاكيد ان البعد الرمزي لاختيار العرض الغنائي "نغمة اصل" في يوم الزي التراثي هو عظيم وتنفرد به كفر قرع لتكون السباقة لهذه المبادرة التي الهبت الجماهير وملات فضاءات القاعة حبا وحماسا وفرحا وتراثا، كما بعثت مديرة القصر الثقافي بتحية لروح فنان التراث الراحل الفنان شفيق كبها والراحل يوسف ابو ليل، الفنان حميد ابو ليل والفنان صالح ابو ليل مؤكدة دور كفر قرع الريادي في ترسيخ التراث والفن العريق.</data>
</edge>
<edge source="e6a3f1ac09eed0b457f2db0fc9f443102bf0ca1e9104b2189db8b93ca42a15e8" target="f56621a8108f1cfc69780f0373c1ebef62d881e779c809ac330a291debf0b853" id="055e4c561c0225eec4bfec1752df6184dbd5d15d8735d19b3e9e43c9ddad7f3e">
  <data key="d5">located_in</data>
  <data key="d6">0.85</data>
  <data key="d7">d83cb6e1821693d082fd9d3d84fddab5f2ad82beac2d1e97effa3bc70b6423f4</data>
  <data key="d8">واشارت وزارة السياحة والاثار الي مواقع، بينها سبسطية شمالي الضفة الغربية المحتلة، وبرك سليمان جنوب بيت لحم، والحرم الابراهيمي في الخليل.</data>
</edge>
<edge source="81d42942e9729ce02ac3b9be208defb9159d2cbf5b91fc722bdaaeb435355dab" target="5cc3e443c46c8385c7acee22f357f203fccbaa6fdf987681b2025b13d128c128" id="918313eb30c64a50cb043229a7323efcee15771c92367edfbcf8e6df3a6da8cc">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">bfc10e8852ab0f1e05864eccd3063710dd5df7ae618d59614db08db5f8317e35</data>
  <data key="d8">اجتمع اعضاء نادي الكتاب العربي في اثينا  لمناقشة المجموعة القصصية الخالدة ارض البرتقال الحزين للاديب الفلسطيني غسان كنفاني، وذلك بحضور ضيف اللقاء المترجم الاستاذ نسيم الاطرش، مترجم العمل الي اللغة اليونانية.</data>
</edge>
<edge source="81d42942e9729ce02ac3b9be208defb9159d2cbf5b91fc722bdaaeb435355dab" target="30d552853c2465157bc97d9f3c0108dcbaadf5288c972a8aee3c85846021e716" id="9b3eb01cc5c6c4ebed9359bd67e22db5ea0c67fc5cde76e724c3fecf225c874e">
  <data key="d5">discussed_work_of</data>
  <data key="d6">0.85</data>
  <data key="d7">bfc10e8852ab0f1e05864eccd3063710dd5df7ae618d59614db08db5f8317e35</data>
  <data key="d8">اجتمع اعضاء نادي الكتاب العربي في اثينا  لمناقشة المجموعة القصصية الخالدة ارض البرتقال الحزين للاديب الفلسطيني غسان كنفاني، وذلك بحضور ضيف اللقاء المترجم الاستاذ نسيم الاطرش، مترجم العمل الي اللغة اليونانية.</data>
</edge>
<edge source="92926452c976b78f94133d886c7bf0dc7305b5e1bc9f41a0abf50823b85193ae" target="4f77c8111c83730922f1648187ed001ede5939331a7a0675d72c4aa7ec023f36" id="a6ca38ad60ac882ebf77cfbdb229d9fbf33b44580032d64308437581312ba4a2">
  <data key="d5">located_in</data>
  <data key="d6">0.7</data>
  <data key="d7">bfc10e8852ab0f1e05864eccd3063710dd5df7ae618d59614db08db5f8317e35</data>
  <data key="d8">وقد استهل اللقاء بكلمة ترحيبية من الاستاذة المنسقة الناشطة والمترجمة نوزت حديد، حيث رحبت بالحضور الكريم واكدت علي اهمية هذه اللقاءات الثقافية في تعزيز الحوار والتواصل بين ابناء الجالية العربية والمهتمين بالادب والثقافة في اليونان.</data>
</edge>
</graph></graphml>