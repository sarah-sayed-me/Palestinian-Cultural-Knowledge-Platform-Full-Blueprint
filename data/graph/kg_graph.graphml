  <data key="d8">توفي ابو عرب في مدينة حمص في 2 مارس 2014.</data>
</edge>
<edge source="c488bc2cb575980d59828ed8fc91496cdd7ba08478fa3fa20e39939efd891b1b" target="f9b2472dadaae6c5e13301770d798de4e2214f3b538fd12cd306dd77253f0aec" id="87c60eb31645e6d4652ef8105552aa3a12535050bdc0ad65b46d1c42fb80af7a">
