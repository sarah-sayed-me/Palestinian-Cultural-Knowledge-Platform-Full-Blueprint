<edge source="c488bc2cb575980d59828ed8fc91496cdd7ba08478fa3fa20e39939efd891b1b" target="ddd8951040061488bd5ed833b5e55a3c5a3077d9afbdaba8bba64835fd087ef0" id="0b26835b5c37e4efb8966de872143d438127159ddb913941ab3f6319b8363c43">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">193611244cee3786513df2959efa909eb4f7f93cc0f516c5e6b08a5de7d68b34</data>
  <data key="d8">فنزح ابو عرب الي قرية عرابة البطوف ومكث فيها مدة شهرين ليتوجه بعدها الي لبنان ثم الي سوريا وتونس ومخيمات الشتات في العالم.</data>
</edge>
<edge source="c488bc2cb575980d59828ed8fc91496cdd7ba08478fa3fa20e39939efd891b1b" target="3dd817b002deb7dfe26b7bc462de86d8a72414901d57dbaed8f72f501a913749" id="237e3ce232a5b0ee920b8eda02c1ce67d940e2583a596bf93b7457823e130232">
  <data key="d5">traveled_to</data>
  <data key="d6">0.8</data>
