  <data key="d7">a36f40b2fea80a16fc4fbefaa27121fd0df6ea77d5bca026db9e19431b014981</data>
  <data key="d8">واكد محافظ نابلس تضامن محافظة نابلس الكامل مع اهالي بلدة قصرة، ورفضها المطلق لكل اشكال الاعتداء علي دور العبادة والمقدسات الدينية .</data>
</edge>
<edge source="0741670ab0d0ecdce3cb31ae999a86a99e1a6984ba74079b551d7bc25d7f4831" target="eb8b9ef26fdfb3fedbfc0b34fa57d79afe75bffa85fe1d1c58aa31dfd679db5e" id="9a2806f9a471b3c1f4dbca9ac0240abbfdeb71293c62cf9dcdb36f798d12d043">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">dc29835d8cf194170f8e5035de4a6d7f04a542d59b1f01a39ee61f2c1b0786e2</data>
  <data key="d8">رام الله 26-7-2026 وفا – شددت قوات الاحتلال الاسرائيلي، اليوم الاحد، اجراءاتها العسكرية في محافظة رام الله والبيرة .</data>
</edge>
<edge source="0741670ab0d0ecdce3cb31ae999a86a99e1a6984ba74079b551d7bc25d7f4831" target="734de0e7cda00d472c4dad60dfc769a52d2a02bc2f38a590a9540ad490fb480c" id="573ca30526454606c93c5373c18de6a36a43023a8fe05435be4337fae6edc78f">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">aaf5c99209cc784a4fb32e92739bb6f9b99b0dc25804008aed27cc52a6448bad</data>
  <data key="d8">رام الله 26-7-2026 وفا – اصيب عدد من العاملين، صباح اليوم الاحد، جراء اعتداء مستعمرين عليهم في بلدة كفر مالك شرق رام الله، واضرموا النار في معدات ثقيلة .</data>
</edge>
<edge source="0741670ab0d0ecdce3cb31ae999a86a99e1a6984ba74079b551d7bc25d7f4831" target="793cdb0259ef3912b4734361e8953a8617407b185fc6071a20b0426c9e50ad47" id="f2d43683dd3ce874d81a438967c64d55c3297553c7b47017177d1d167c5e196d">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">e1f6c886de05a6004d1dd51f0bf65ef6ab32cb2e16563935c40863b3e3b29c19</data>
  <data key="d8">رام الله 24-7-2026 وفا- اظهرت بيانات الجهاز المركزي للاحصاء الفلسطيني، انخفاض مؤشرات اسعار تكاليف البناء للمباني السكنية وغير السكنية ومباني العظم، الي جانب انخفاض اسعار تكاليف انشاء الطرق وشبكات المياه والصرف الصحي في الضفة، خلال شهر حزيران 2026، مقارنة بشهر ايار الماضي .</data>
</edge>
<edge source="0741670ab0d0ecdce3cb31ae999a86a99e1a6984ba74079b551d7bc25d7f4831" target="710f17abe31d379e66bf74d338e143490593f86ba8bd633e1efbf648bfd6e14d" id="a3082cb2309d726beec8b48b3a5d415511826072d95e8610f789cd7f497a08e9">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">3df3aafd9d59d66b110b7311895b7bfa8980c3f26d8cde5bd4f96f36fdcb8164</data>
  <data key="d8">تقول احدي شخصيات الرواية «لم يعد هناك في رام الله الا الترحم علي شهداء الانتفاضتين، لا يوجد فيها ما يرضي الروح من اشكال نضالنا القديم سوي ضريح القائد الرمز ومتحف محمود درويش.</data>
</edge>
<edge source="0fad22b2cd7e2e8372c563d378737597a220e3d036e70adee3619b26202eee03" target="33157952dbfc1c69ec1dc9cb2be4e47c438a6822836f39fc55c4bff42d7cdc91" id="ee136e6096b866e9dc57f82b630c4a3d61df4a13fc88cd3bc1437edd4c6dab59">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">a62ed687f1595b3041ff677f3d5a276109b3ee26fae39e5a451066685492cf5e</data>
  <data key="d8">بيت لحم 26-7-2026 وفا- خطت قوات الاحتلال الاسرائيلي، اليوم الاحد، شعارات عنصرية، علي جدران منزلين في بلدة الخضر ومخيم عايدة بمحافظة بيت لحم.</data>
</edge>
<edge source="77f3a36bd34c3825823dfca123dcc4969c460703ec045ded14c12e42be8099ea" target="33157952dbfc1c69ec1dc9cb2be4e47c438a6822836f39fc55c4bff42d7cdc91" id="4d411cf0b5a4ead6925ee415024345f4fad5c21d97b6730f1630cef9422378d6">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">a62ed687f1595b3041ff677f3d5a276109b3ee26fae39e5a451066685492cf5e</data>
  <data key="d8">بيت لحم 26-7-2026 وفا- خطت قوات الاحتلال الاسرائيلي، اليوم الاحد، شعارات عنصرية، علي جدران منزلين في بلدة الخضر ومخيم عايدة بمحافظة بيت لحم.</data>
</edge>
<edge source="b99e7230317ec3ccf3fb1552d6f1f711b5e4981dc0b7249ee326c7c8d4c75d3b" target="70f8a9e31404a4838e507c4ffd5125f5239a7edd674b0594957aeb53dd00641c" id="e9799baa7c467d78dcedc5619c2df978e09c366f6d6408ca691183445aaddc80">
  <data key="d5">originated_in</data>
  <data key="d6">0.85</data>
  <data key="d7">6ad04a35c719588f322cf4a72b64e3f14530d5cef7f6a57d71e74d15b984fa53</data>
  <data key="d8">لذلك فان دخول الدبكة الفلسطينية الي الافراح المصرية لا يمكن فهمه باعتباره مجرد اضافة فنية، بل باعتباره تعبيرا عن حضور فلسطين في الوعي الشعبي المصري بصورة غير مسبوقة، ففي علم الاجتماع الثقافي تعد طقوس الاحتفال من اكثر المؤشرات دقة علي التحولات العميقة في المزاج العام، لانها تنشا تلقائيا ومن دون توجيه او قرار.</data>
</edge>
<edge source="eb4c417f40debc27e7845d8f8bfa8d531426e7a1d59352f9c7cb23025b4b57e7" target="5108a95a4ff681f2f23e0303bc90944b5a5cc3918ff9a15130addac2ffc9bdb6" id="ab8e5851390503eed7bf801df39cde9ff907c5d14fc2f9f123faa632beb8b9e0">
  <data key="d5">related_to</data>
  <data key="d6">0.8</data>
  <data key="d7">78168a395447428216985271c6e0052da7d8e3d6b9b4a83051575c1d3a78d19f</data>
  <data key="d8">واوضح ان فيلم "جنين جنين" تجاوز حدود العمل السينمائي التقليدي ليصبح شهادة وطنية وانسانية توثق جانبا من معاناة الفلسطينيين تحت الاحتلال، وتسلط الضوء علي ما شهده مخيم جنين من احداث، رغم ما تعرض له الفيلم وصانعه من حملات تحريض وملاحقة ومحاولات للتشويه والمنع .</data>
</edge>
<edge source="f9b2472dadaae6c5e13301770d798de4e2214f3b538fd12cd306dd77253f0aec" target="afb6cb50d05629b2109bb5c3a1027bedb54419332094d58ffac44bf94c6df6c1" id="c88571e346310b3d945759ed07271c613cc778f0a00d1260440e48c59b971a5b">
  <data key="d5">located_between</data>
  <data key="d6">0.8</data>
  <data key="d7">193611244cee3786513df2959efa909eb4f7f93cc0f516c5e6b08a5de7d68b34</data>
  <data key="d8">ولد ابو عرب في قرية الشجرة (الواقعة في منتصف الطريق بين مدينتي الناصرة وطبريا)، طبريا في فلسطين سنة 1931، وهي ايضا قرية رسام الكاريكاتير المغتال في 1987 ناجي العلي.</data>
</edge>
<edge source="411f68eb080607143b1a1b4ed39ad48ae9da2ce6308bd759de4a57bea6a90a45" target="b1aa9d1e318b86b8c8fc3793440909b594b76d30f20fb75a031c1249259174ec" id="9f611b5d739f5eedb244b31c4b900c5c5bf670d92f83839ed59a76d9853f287a">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">8720aa7f72151a1672f1c8870c25e774ab6bee0a9b4d6299cc6dfebe07800f19</data>
  <data key="d8">طولكرم 26-7-2026 وفا- اقدم مستعمرون، فجر اليوم الاحد، علي احراق اجزاء من مسجد في قرية كور جنوب مدينة طولكرم، عقب اقتحامهم القرية، وخطوا شعارات علي جدرانه، في اعتداء اجرامي ثان يطال دور العبادة والمقدسات الاسلامية، بعد احراقهم مسجدا قيد الانشاء في بلدة قصرة جنوب نابلس في ساعات الصباح الباكر.</data>
</edge>
<edge source="4d14ce35882e1992b618527c942f84f50f5609800ff43c13378a98a58c0582b9" target="b1aa9d1e318b86b8c8fc3793440909b594b76d30f20fb75a031c1249259174ec" id="6c58e79ce291fe355391644faf21dba8db1d430df8057e5a0df93c4e4ff3f6e4">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">8720aa7f72151a1672f1c8870c25e774ab6bee0a9b4d6299cc6dfebe07800f19</data>
  <data key="d8">طولكرم 26-7-2026 وفا- اقدم مستعمرون، فجر اليوم الاحد، علي احراق اجزاء من مسجد في قرية كور جنوب مدينة طولكرم، عقب اقتحامهم القرية، وخطوا شعارات علي جدرانه، في اعتداء اجرامي ثان يطال دور العبادة والمقدسات الاسلامية، بعد احراقهم مسجدا قيد الانشاء في بلدة قصرة جنوب نابلس في ساعات الصباح الباكر.</data>
</edge>
<edge source="ecc0feb1cd0b0d8fc3fb0c66ba5797d3aa185c60fe1095239cf9cb419ea62526" target="70f8a9e31404a4838e507c4ffd5125f5239a7edd674b0594957aeb53dd00641c" id="6db0b69cb09e8454c8c4c4c346f977b973edd67736200c97242ea22c065a94f9">
  <data key="d5">collaboration_with</data>
  <data key="d6">0.85</data>
  <data key="d7">10f72a1e03b624632fdf02724971420328c69883929520feb77870f02a72d583</data>
  <data key="d8">اعلنت وزارة السياحة والاثار الفلسطينية ، اليوم الخميس، عن اعتماد تسجيل 12 موقعا فلسطينيا جديدا علي القائمة التمهيدية للتراث العالمي لدي منظمة الامم المتحدة للتربية والعلم والثقافة (اليونسكو)، بالتعاون مع المندوبية الدائمة لدولة فلسطين لدي اليونسكو، ليرتفع بذلك عدد المواقع الفلسطينية المدرجة علي القائمة التمهيدية الي 23 موقعا وفقا لما نقلته وكالة "وفا".</data>
</edge>
<edge source="8285b0a248060868883ebf6c9fbdc4f924b076bf50e3a31fdde63c61cb6b3a9f" target="5c9dc77ef48c7ca5aedc861ea4fd5f15e2a1845b426ee06808c9d2e7c95e28d3" id="21ab347d67fa161b21fcd512f7f2a76818cf5ac620e900d5a883716e11b26a2e">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">af02fbb2f542afeb0969e278c51bc86629ea93d36f1a2d174c9da2bb900d7857</data>
  <data key="d8">الخليل، 26-7-2026 وفا– اقتحم مستعمرون، صباح اليوم الاحد، بلدة اذنا غرب الخليل، فيما تواصل قوات الاحتلال اغلاق مدخلها وتشديد اجراءاتها العسكرية .</data>
</edge>
<edge source="b6e4664cd0774f9d0b3dedad3816c58a94e8cda0134b311643eae76c79d9fb35" target="c9a030d7f176b776e582214820330caab0b95162eecaad6e2a5280eac7b3fd1d" id="ba31055ac58ccc1ac4f3f02c65c21307ed0394de7e6179fb8c2b1a7facf4d5e5">
  <data key="d5">located_in</data>
  <data key="d6">0.8</data>
  <data key="d7">4ac1146ef990de8659e494b60537c510f274031cc6e8ea0cbfa21f72d80ea695</data>
  <data key="d8">وافادت مصادر امنية ومحلية، بان جيبات الاحتلال اقتحمت احياء عدة من مدينة نابلس، ومخيمي عسكر الجديد والقديم، ومنطقة البلد شرقا، اضافة الي بلدات تل جنوب غرب نابلس، وحوارة، وعوريف، وكفر قليل جنوب نابلس، وعصيرة الشمالية شمال نابلس، وسالم شرقا، وداهمت عددا كبيرا من المنازل، وفتشتها، وعبثت بمحتوياتها .</data>
</edge>
