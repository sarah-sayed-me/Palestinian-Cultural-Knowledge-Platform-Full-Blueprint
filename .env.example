# Copy to .env and fill in real values. .env is git-ignored — never commit it.

# Hugging Face (already used by scripts/export_to_hf.py, scripts/publish_to_hf.py)
HF_TOKEN=

# Postgres + pgvector (docker-compose.yml) — the RAG vector store, see ROADMAP.md Section 3.2
POSTGRES_USER=pckp
POSTGRES_PASSWORD=pckp
POSTGRES_DB=pckp
DATABASE_URL=postgresql://pckp:pckp@localhost:5434/pckp

# Ollama local LLM server (RAG generator) — default if Ollama runs on this machine.
# See ROADMAP.md Section 3.4 for the model choice and the Gemini free-tier fallback.
OLLAMA_HOST=http://localhost:11434
